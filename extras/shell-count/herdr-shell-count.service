[Unit]
Description=Report each herdr agent's running shell count to the sidebar
# Don't start at all once herdr has been removed.
ConditionPathExists=%h/.local/bin/herdr

[Service]
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/herdr-shell-count
# The watcher exits cleanly when herdr is uninstalled; only restart real crashes.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
