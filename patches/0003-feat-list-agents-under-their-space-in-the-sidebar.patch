+#[test]
+fn multi_machine_next_agent_goes_to_the_most_urgent_across_machines() {
+    let (mut state, remote) = multi_machine_state(AgentStatus::Blocked);
+    let mut outcome = ClientShellInput::default();
+    assert!(state.handle_endpoint_navigation(crate::input::KeybindAction::NextAgent, &mut outcome));
+    assert!(matches!(
+        outcome.actions.as_slice(),
+        [ClientShellAction::ActivateEndpoint {
+            endpoint_id,
+            target: Some(ClientEndpointFocusTarget::Pane(pane)),
+        }] if *endpoint_id == remote && pane == "pane_2"
+    ));
+    // focus_agent numbers follow the tree: Local's two agents, then Build's.
+    let targets = crate::client::shell::space_agents::endpoint_focus_targets(&state.endpoints);
+    let order = targets
+        .iter()
+        .map(|target| (target.endpoint_id == remote, target.pane_id.as_str()))
+        .collect::<Vec<_>>();
+    assert_eq!(
+        order,
+        [
+            (false, "pane_1"),
+            (false, "pane_2"),
+            (true, "pane_1"),
+            (true, "pane_2")
+        ]
+    );
+}
