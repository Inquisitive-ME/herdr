new file mode 100644
index 00000000..a06c9a7d
--- /dev/null
+++ b/src/client/shell/space_agents.rs
@@ -0,0 +1,1552 @@
+//! Fork addition: the expanded sidebar lists each space's agents and terminals under it
+//! as a tree, and the agent section only shows agents that need input.
+//!
+//! Lives in its own file so upstream sidebar changes rarely conflict with it.
+
+use std::collections::HashSet;
+
+use ratatui::{
+    text::{Line, Span},
+    widgets::{Paragraph, Widget},
+};
+
+use super::render::put_text;
+use super::*;
+use crate::api::schema::AgentStatus;
+use crate::protocol::{ClientShellAgent, ClientShellPane, ClientShellTab};
+use crossterm::event::{MouseButton, MouseEvent, MouseEventKind};
+
+/// Rows the agent section draws above its list: divider, title, blank line.
+const NEEDS_INPUT_HEADER_ROWS: u16 = 3;
+
+/// Keys stored with the client's collapsed worktree groups, so they persist the same way.
+const COLLAPSED_KEY_PREFIX: &str = "fork.space-collapsed:";
+const TERMINALS_HIDDEN_KEY_PREFIX: &str = "fork.space-terminals-hidden:";
+
+/// How urgently an agent wants the user, most urgent first.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
+pub(in crate::client::shell) enum Attention {
+    /// Blocked on a prompt: a permission, a question or a plan approval.
+    NeedsInput,
+    /// Finished a turn the user hasn't looked at yet.
+    Finished,
+}
+
+impl Attention {
+    pub(in crate::client::shell) fn of(status: AgentStatus) -> Option<Self> {
+        match status {
+            AgentStatus::Blocked => Some(Self::NeedsInput),
+            AgentStatus::Done => Some(Self::Finished),
+            AgentStatus::Working | AgentStatus::Idle | AgentStatus::Unknown => None,
+        }
+    }
+
+    fn title(self) -> &'static str {
+        match self {
+            Self::NeedsInput => " needs input",
+            Self::Finished => " finished",
+        }
+    }
+}
+
+/// One entry of the attention section: a group heading or an agent row.
+pub(in crate::client::shell) enum AttentionEntry<T> {
+    /// A blank line, then the group's name.
+    Heading(Attention),
+    Agent(T),
+}
+
+impl<T> AttentionEntry<T> {
+    pub(in crate::client::shell) fn lines(&self, agent_lines: impl Fn(&T) -> usize) -> usize {
+        match self {
+            Self::Heading(_) => 2,
+            Self::Agent(row) => agent_lines(row),
+        }
+    }
+}
+
+/// Group the agents waiting on the user, most urgent group first, keeping their order
+/// within a group. The first group names the section; later groups get a heading.
+pub(in crate::client::shell) fn attention_entries<T>(
+    rows: Vec<T>,
+    status: impl Fn(&T) -> AgentStatus,
+) -> (&'static str, Vec<AttentionEntry<T>>) {
+    let mut grouped = rows
+        .into_iter()
+        .filter_map(|row| Attention::of(status(&row)).map(|attention| (attention, row)))
+        .collect::<Vec<_>>();
+    grouped.sort_by_key(|(attention, _)| *attention);
+    let title = grouped
+        .first()
+        .map_or(Attention::NeedsInput.title(), |(attention, _)| {
+            attention.title()
+        });
+    let mut entries = Vec::with_capacity(grouped.len() + 1);
+    let mut previous = None;
+    for (attention, row) in grouped {
+        if previous.is_some_and(|previous| previous != attention) {
+            entries.push(AttentionEntry::Heading(attention));
+        }
+        previous = Some(attention);
+        entries.push(AttentionEntry::Agent(row));
+    }
+    (title, entries)
+}
+
+/// Draw a group heading on the second line of its two-line entry.
+pub(in crate::client::shell) fn render_attention_heading(
+    buffer: &mut Buffer,
+    rect: Rect,
+    attention: Attention,
+    config: &ClientShellConfig,
+) {
+    if rect.height < 2 {
+        return;
+    }
+    put_text(
+        buffer,
+        rect.x,
+        rect.y + 1,
+        rect.width,
+        attention.title(),
+        Style::default()
+            .fg(config.palette.overlay0)
+            .add_modifier(Modifier::BOLD),
+    );
+}
+
+/// Height of the attention section's list for these rows.
+pub(in crate::client::shell) fn attention_list_height<T>(
+    rows: Vec<T>,
+    status: impl Fn(&T) -> AgentStatus,
+    agent_lines: impl Fn(&T) -> usize,
+    row_gap: u16,
+) -> u16 {
+    let (_, entries) = attention_entries(rows, status);
+    list_height(
+        entries
+            .iter()
+            .map(|entry| entry.lines(&agent_lines).min(u16::MAX as usize) as u16),
+        row_gap,
+    )
+}
+
+/// Key that marks a space's tree as collapsed.
+pub(in crate::client::shell) fn collapsed_key(workspace_id: &str) -> String {
+    format!("{COLLAPSED_KEY_PREFIX}{workspace_id}")
+}
+
+/// Key that hides a space's plain terminals.
+pub(in crate::client::shell) fn terminals_hidden_key(workspace_id: &str) -> String {
+    format!("{TERMINALS_HIDDEN_KEY_PREFIX}{workspace_id}")
+}
+
+/// What one entry of a space's tree shows.
+pub(in crate::client::shell) enum SpaceItemKind<'a> {
+    Agent(&'a ClientShellAgent),
+    Terminal,
+}
+
+/// One pane listed under its space.
+pub(in crate::client::shell) struct SpaceItem<'a> {
+    pub(in crate::client::shell) pane_id: &'a str,
+    pub(in crate::client::shell) kind: SpaceItemKind<'a>,
+    label: String,
+    focused: bool,
+}
+
+impl SpaceItem<'_> {
+    pub(in crate::client::shell) fn agent(&self) -> Option<&ClientShellAgent> {
+        match self.kind {
+            SpaceItemKind::Agent(agent) => Some(agent),
+            SpaceItemKind::Terminal => None,
+        }
+    }
+}
+
+/// The panes listed under one space, in tab order.
+pub(in crate::client::shell) struct SpaceTree<'a> {
+    pub(in crate::client::shell) workspace_id: &'a str,
+    pub(in crate::client::shell) items: Vec<SpaceItem<'a>>,
+    pub(in crate::client::shell) collapsed: bool,
+}
+
+impl SpaceTree<'_> {
+    /// Rows the tree takes under its space: one summary row while collapsed.
+    pub(in crate::client::shell) fn height(&self) -> u16 {
+        if self.items.is_empty() {
+            0
+        } else if self.collapsed {
+            1
+        } else {
+            u16::try_from(self.items.len()).unwrap_or(u16::MAX)
+        }
+    }
+}
+
+/// Build the tree for one space: each tab's panes, agents first-class and plain
+/// terminals dimmed (unless hidden for this space).
+pub(in crate::client::shell) fn space_tree<'a>(
+    snapshot: &'a ClientShellSnapshot,
+    workspace_id: &'a str,
+    collapsed_groups: &HashSet<String>,
+) -> SpaceTree<'a> {
+    let show_terminals = !collapsed_groups.contains(&terminals_hidden_key(workspace_id));
+    let tabs = snapshot
+        .tabs
+        .iter()
+        .filter(|tab| tab.workspace_id == workspace_id)
+        .collect::<Vec<_>>();
+    let panes = snapshot
+        .panes
+        .iter()
+        .filter(|pane| pane.workspace_id == workspace_id)
+        .collect::<Vec<_>>();
+    let mut items = Vec::new();
+    for tab in &tabs {
+        let tab_panes = panes
+            .iter()
+            .filter(|pane| pane.tab_id == tab.tab_id)
+            .collect::<Vec<_>>();
+        for pane in &tab_panes {
+            let agent = snapshot
+                .agents
+                .iter()
+                .find(|agent| agent.pane_id == pane.pane_id);
+            let (kind, label) = match agent {
+                Some(agent) => (
+                    SpaceItemKind::Agent(agent),
+                    agent_label(snapshot, agent).to_owned(),
+                ),
+                None if show_terminals => (SpaceItemKind::Terminal, terminal_label(tab, pane)),
+                None => continue,
+            };
+            items.push(SpaceItem {
+                pane_id: &pane.pane_id,
+                kind,
+                label,
+                focused: pane.focused,
+            });
+        }
+    }
+    // Never hide an agent the pane list doesn't cover.
+    let unlisted = snapshot
+        .agents
+        .iter()
+        .filter(|agent| {
+            agent.workspace_id == workspace_id
+                && !items.iter().any(|item| item.pane_id == agent.pane_id)
+        })
+        .collect::<Vec<_>>();
+    for agent in unlisted {
+        items.push(SpaceItem {
+            pane_id: &agent.pane_id,
+            kind: SpaceItemKind::Agent(agent),
+            label: agent_label(snapshot, agent).to_owned(),
+            focused: agent.focused,
+        });
+    }
+    SpaceTree {
+        workspace_id,
+        collapsed: !items.is_empty() && collapsed_groups.contains(&collapsed_key(workspace_id)),
+        items,
+    }
+}
+
+/// Rows a space's tree takes under it.
+pub(in crate::client::shell) fn space_tree_height(
+    snapshot: &ClientShellSnapshot,
+    workspace_id: &str,
+    collapsed_groups: &HashSet<String>,
+) -> u16 {
+    space_tree(snapshot, workspace_id, collapsed_groups).height()
+}
+
+/// Every agent in sidebar order (spaces top to bottom, then tabs), collapsed or not.
+pub(in crate::client::shell) fn tree_agent_pane_ids(snapshot: &ClientShellSnapshot) -> Vec<String> {
+    let none_collapsed = HashSet::new();
+    super::sidebar::workspace_entries(snapshot, &none_collapsed)
+        .iter()
+        .filter_map(|entry| snapshot.workspaces.get(entry.index))
+        .flat_map(|workspace| {
+            space_tree(snapshot, &workspace.workspace_id, &none_collapsed)
+                .items
+                .into_iter()
+                .filter(|item| item.agent().is_some())
+                .map(|item| item.pane_id.to_owned())
+                .collect::<Vec<_>>()
+        })
+        .collect()
+}
+
+/// The agents next/previous agent cycles through, in sidebar order: those needing input
+/// when any do, else unread finished ones, else all of them.
+pub(in crate::client::shell) fn agent_cycle(snapshot: &ClientShellSnapshot) -> Vec<String> {
+    let all = tree_agent_pane_ids(snapshot);
+    for attention in [Attention::NeedsInput, Attention::Finished] {
+        let group = all
+            .iter()
+            .filter(|pane_id| {
+                snapshot.agents.iter().any(|agent| {
+                    agent.pane_id == **pane_id
+                        && Attention::of(agent.agent_status) == Some(attention)
+                })
+            })
+            .cloned()
+            .collect::<Vec<_>>();
+        if !group.is_empty() {
+            return group;
+        }
+    }
+    all
+}
+
+/// Online machines' agents in sidebar order: machines top to bottom, then spaces, then
+/// tabs, with each agent's status as this client shows it.
+fn endpoint_tree_agents(
+    endpoints: &[ClientShellEndpoint],
+) -> Vec<(ClientEndpointId, String, AgentStatus)> {
+    endpoints
+        .iter()
+        .filter(|endpoint| endpoint.status == ClientEndpointStatus::Online)
+        .filter_map(|endpoint| Some((endpoint, endpoint.snapshot.as_deref()?)))
+        .flat_map(|(endpoint, snapshot)| {
+            tree_agent_pane_ids(snapshot)
+                .into_iter()
+                .map(|pane_id| {
+                    let status = snapshot
+                        .agents
+                        .iter()
+                        .find(|agent| agent.pane_id == pane_id)
+                        .map_or(AgentStatus::Unknown, |agent| agent.agent_status);
+                    (endpoint.endpoint_id.clone(), pane_id, status)
+                })
+                .collect::<Vec<_>>()
+        })
+        .collect()
+}
+
+fn aggregate_targets(
+    agents: impl IntoIterator<Item = (ClientEndpointId, String, AgentStatus)>,
+) -> Vec<super::aggregate_navigation::AggregateAgentTarget> {
+    agents
+        .into_iter()
+        .map(
+            |(endpoint_id, pane_id, _)| super::aggregate_navigation::AggregateAgentTarget {
+                endpoint_id,
+                pane_id,
+            },
+        )
+        .collect()
+}
+
+/// Multi-machine `focus_agent` targets: every agent in sidebar order.
+pub(in crate::client::shell) fn endpoint_focus_targets(
+    endpoints: &[ClientShellEndpoint],
+) -> Vec<super::aggregate_navigation::AggregateAgentTarget> {
+    aggregate_targets(endpoint_tree_agents(endpoints))
+}
+
+/// Multi-machine next/previous agent: the most urgent non-empty group across all
+/// machines, else every agent, in sidebar order.
+pub(in crate::client::shell) fn endpoint_agent_cycle(
+    endpoints: &[ClientShellEndpoint],
+) -> Vec<super::aggregate_navigation::AggregateAgentTarget> {
+    let all = endpoint_tree_agents(endpoints);
+    for attention in [Attention::NeedsInput, Attention::Finished] {
+        let group = all
+            .iter()
+            .filter(|(_, _, status)| Attention::of(*status) == Some(attention))
+            .cloned()
+            .collect::<Vec<_>>();
+        if !group.is_empty() {
+            return aggregate_targets(group);
+        }
+    }
+    aggregate_targets(all)
+}
+
+/// Multi-machine agent numbers 1-9 as (machine, pane), when `keys.focus_agent` is bound.
+pub(in crate::client::shell) fn endpoint_agent_numbers(
+    endpoints: &[ClientShellEndpoint],
+    config: &ClientShellConfig,
+) -> Vec<(ClientEndpointId, String)> {
+    if config.keybinds.keybinds.focus_agent.is_empty() {
+        return Vec::new();
+    }
+    endpoint_tree_agents(endpoints)
+        .into_iter()
+        .take(9)
+        .map(|(endpoint_id, pane_id, _)| (endpoint_id, pane_id))
+        .collect()
+}
+
+/// A named tab says the most about an agent; otherwise use the agent's own title.
+fn agent_label<'a>(snapshot: &'a ClientShellSnapshot, agent: &'a ClientShellAgent) -> &'a str {
+    snapshot
+        .tabs
+        .iter()
+        .find(|tab| tab.tab_id == agent.tab_id && tab.custom_label)
+        .map(|tab| tab.label.as_str())
+        .or(agent.name.as_deref())
+        .or(agent
+            .terminal_title_stripped
+            .as_deref()
+            .filter(|title| !title.is_empty()))
+        .or(agent.display_agent.as_deref())
+        .or(agent.agent.as_deref())
+        .unwrap_or(agent.pane_id.as_str())
+}
+
+/// A terminal's pane or tab name, else the folder it's in.
+fn terminal_label(tab: &ClientShellTab, pane: &ClientShellPane) -> String {
+    if let Some(label) = pane.label.as_deref().filter(|label| !label.is_empty()) {
+        return label.to_owned();
+    }
+    if tab.custom_label {
+        return tab.label.clone();
+    }
+    match pane_dir(pane).and_then(|dir| dir.trim_end_matches('/').rsplit('/').next()) {
+        Some(name) if !name.is_empty() => name.to_owned(),
+        _ => "shell".to_owned(),
+    }
+}
+
+/// The directory a pane's foreground program works in.
+fn pane_dir(pane: &ClientShellPane) -> Option<&str> {
+    pane.foreground_cwd
+        .as_deref()
+        .or(pane.cwd.as_deref())
+        .filter(|dir| !dir.is_empty())
+}
+
+/// "2 shells" from the `shells` pane token, which the herdr-shell-count watcher reports
+/// with the number of shell commands the agent process is running.
+fn shell_count_text(agent: &ClientShellAgent) -> Option<String> {
+    let count = agent
+        .tokens
+        .iter()
+        .find(|(name, _)| name == "shells")
+        .and_then(|(_, value)| value.trim().parse::<u32>().ok())
+        .filter(|count| *count > 0)?;
+    Some(format!(
+        " · {count} shell{}",
+        if count == 1 { "" } else { "s" }
+    ))
+}
+
+/// How long an active agent has been working or waiting, from the `state_since_ms` token:
+/// "12m", "3h", "2d". Nothing under a minute.
+fn state_age_text(agent: &ClientShellAgent, now_ms: u64) -> Option<String> {
+    let minutes = state_age_minutes(agent, now_ms)?;
+    match minutes {
+        0 => None,
+        1..=59 => Some(format!("{minutes}m")),
+        60..=1439 => Some(format!("{}h", minutes / 60)),
+        _ => Some(format!("{}d", minutes / 1440)),
+    }
+}
+
+/// Minutes an active agent has been running or waiting on the user. Idle and finished
+/// agents have no age: how long something has sat idle isn't worth the space.
+fn state_age_minutes(agent: &ClientShellAgent, now_ms: u64) -> Option<u64> {
+    if !matches!(
+        agent.agent_status,
+        AgentStatus::Working | AgentStatus::Blocked
+    ) {
+        return None;
+    }
+    let since = agent
+        .tokens
+        .iter()
+        .find(|(name, _)| name == crate::metadata_tokens::STATE_SINCE_TOKEN)
+        .and_then(|(_, value)| value.parse::<u64>().ok())?;
+    Some(now_ms.saturating_sub(since) / 60_000)
+}
+
+/// A number that changes exactly when `state_age_text`'s label does.
+fn age_label_bucket(minutes: u64) -> u64 {
+    match minutes {
+        0..=59 => minutes,
+        60..=1439 => 100 + minutes / 60,
+        _ => 1_000 + minutes / 1440,
+    }
+}
+
+pub(in crate::client::shell) fn now_unix_ms() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .ok()
+        .and_then(|elapsed| u64::try_from(elapsed.as_millis()).ok())
+        .unwrap_or(0)
+}
+
+/// Draw the ▾/▸ toggle at the right of a space's first row. A worktree group toggle
+/// already sits at the edge, so then it goes two columns in.
+pub(in crate::client::shell) fn render_space_toggle(
+    buffer: &mut Buffer,
+    space_rect: Rect,
+    tree: &SpaceTree<'_>,
+    has_group_toggle: bool,
+    palette: &Palette,
+) -> Option<(Rect, String)> {
+    let inset = if has_group_toggle { 3 } else { 1 };
+    if tree.items.is_empty() || space_rect.width <= inset + 4 || space_rect.height == 0 {
+        return None;
+    }
+    let toggle = Rect::new(space_rect.right() - inset, space_rect.y, 1, 1);
+    put_text(
+        buffer,
+        toggle.x,
+        toggle.y,
+        1,
+        if tree.collapsed { "▸" } else { "▾" },
+        Style::default().fg(if tree.collapsed {
+            palette.accent
+        } else {
+            palette.overlay0
+        }),
+    );
+    Some((toggle, collapsed_key(tree.workspace_id)))
+}
+
+/// Draw a space's tree from the top of `area`. Calls `on_line` with each row that
+/// points at a pane; returns the summary row of a collapsed tree, which expands it.
+#[allow(clippy::too_many_arguments)] // mirrors the other sidebar row renderers
+pub(in crate::client::shell) fn render_space_tree(
+    buffer: &mut Buffer,
+    area: Rect,
+    indent: u16,
+    tree: &SpaceTree<'_>,
+    agent_number: &dyn Fn(&str) -> Option<usize>,
+    show_focus: bool,
+    config: &ClientShellConfig,
+    now_ms: u64,
+    mut on_line: impl FnMut(Rect, &SpaceItem<'_>),
+) -> Option<Rect> {
+    let palette = &config.palette;
+    if area.is_empty() || tree.items.is_empty() {
+        return None;
+    }
+    if tree.collapsed {
+        let line = Rect::new(area.x, area.y, area.width, 1);
+        render_summary(buffer, line, indent, tree, config);
+        return Some(line);
+    }
+    let mut y = area.y;
+    for item in &tree.items {
+        if y >= area.bottom() {
+            break;
+        }
+        let rect = Rect::new(area.x, y, area.width, 1);
+        let focused = show_focus && item.focused;
+        if focused {
+            buffer.set_style(rect, Style::default().bg(palette.active_row_bg));
+        }
+        let x = rect.x.saturating_add(indent).min(rect.right());
+        let width = usize::from(rect.right().saturating_sub(x));
+        let number = agent_number(item.pane_id).filter(|index| *index < 9);
+        if let Some(index) = number.filter(|_| indent >= 2) {
+            put_text(
+                buffer,
+                x - 2,
+                y,
+                1,
+                &(index + 1).to_string(),
+                Style::default().fg(palette.overlay0),
+            );
+        }
+        let spans = match item.kind {
+            SpaceItemKind::Agent(agent) => {
+                let label_style = if focused {
+                    Style::default()
+                        .fg(palette.text)
+                        .add_modifier(Modifier::BOLD)
+                } else {
+                    Style::default().fg(palette.subtext0)
+                };
+                let icon = status_icon(agent.agent_status, config.status_indicators);
+                let shells = shell_count_text(agent).unwrap_or_default();
+                let age = state_age_text(agent, now_ms).unwrap_or_default();
+                if !age.is_empty() {
+                    put_text(
+                        buffer,
+                        rect.right().saturating_sub(age.len() as u16),
+                        y,
+                        age.len() as u16,
+                        &age,
+                        Style::default().fg(palette.overlay0),
+                    );
+                }
+                let age_width = if age.is_empty() { 0 } else { age.len() + 1 };
+                // Shorten the label rather than let the shell count or age fall off the edge.
+                let label_width = width.saturating_sub(
+                    UnicodeWidthStr::width(icon)
+                        + 1
+                        + UnicodeWidthStr::width(shells.as_str())
+                        + age_width,
+                );
+                let mut spans = vec![
+                    Span::styled(
+                        icon,
+                        Style::default().fg(status_color(agent.agent_status, palette)),
+                    ),
+                    Span::raw(" "),
+                    Span::styled(
+                        crate::ui::truncate_end(&item.label, label_width),
+                        label_style,
+                    ),
+                ];
+                if !shells.is_empty() {
+                    spans.push(Span::styled(shells, Style::default().fg(palette.overlay0)));
+                }
+                spans
+            }
+            SpaceItemKind::Terminal => {
+                let label_style = if focused {
+                    Style::default()
+                        .fg(palette.text)
+                        .add_modifier(Modifier::BOLD)
+                } else {
+                    Style::default().fg(palette.overlay0)
+                };
+                vec![
+                    Span::styled("›", Style::default().fg(palette.overlay0)),
+                    Span::raw(" "),
+                    Span::styled(
+                        crate::ui::truncate_end(&item.label, width.saturating_sub(2)),
+                        label_style,
+                    ),
+                ]
+            }
+        };
+        let age_width = item
+            .agent()
+            .and_then(|agent| state_age_text(agent, now_ms))
+            .map_or(0, |age| age.len() as u16 + 1);
+        Paragraph::new(Line::from(spans)).render(
+            Rect::new(x, y, (width as u16).saturating_sub(age_width), 1),
+            buffer,
+        );
+        on_line(rect, item);
+        y = rect.bottom();
+    }
+    None
+}
+
+/// One row standing in for a collapsed tree: a count per agent status, then terminals.
+fn render_summary(
+    buffer: &mut Buffer,
+    line: Rect,
+    indent: u16,
+    tree: &SpaceTree<'_>,
+    config: &ClientShellConfig,
+) {
+    let palette = &config.palette;
+    let mut spans = Vec::new();
+    for status in [
+        AgentStatus::Blocked,
+        AgentStatus::Working,
+        AgentStatus::Done,
+        AgentStatus::Idle,
+        AgentStatus::Unknown,
+    ] {
+        let count = tree
+            .items
+            .iter()
+            .filter(|item| {
+                item.agent()
+                    .is_some_and(|agent| agent.agent_status == status)
+            })
+            .count();
+        if count > 0 {
+            spans.push(Span::styled(
+                format!("{}{count} ", status_icon(status, config.status_indicators)),
+                Style::default().fg(status_color(status, palette)),
+            ));
+        }
+    }
+    let terminals = tree
+        .items
+        .iter()
+        .filter(|item| item.agent().is_none())
+        .count();
+    if terminals > 0 {
+        spans.push(Span::styled(
+            format!("›{terminals}"),
+            Style::default().fg(palette.overlay0),
+        ));
+    }
+    let x = line.x.saturating_add(indent).min(line.right());
+    Paragraph::new(Line::from(spans)).render(
+        Rect::new(x, line.y, line.right().saturating_sub(x), 1),
+        buffer,
+    );
+}
+
+/// Pane ids numbered 1-9 on agent lines when `keys.focus_agent` is bound.
+pub(in crate::client::shell) fn agent_numbers(
+    snapshot: &ClientShellSnapshot,
+    config: &ClientShellConfig,
+) -> Vec<String> {
+    if config.keybinds.keybinds.focus_agent.is_empty() {
+        return Vec::new();
+    }
+    let mut ids = tree_agent_pane_ids(snapshot);
+    ids.truncate(9);
+    ids
+}
