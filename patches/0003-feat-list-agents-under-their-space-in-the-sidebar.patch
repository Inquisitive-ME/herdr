+/// Local and a saved machine "Build", both online, each with the tree snapshot.
+fn multi_machine_state(
+    remote_status: AgentStatus,
+) -> (ClientShellState, crate::client::endpoint::ClientEndpointId) {
+    use crate::client::endpoint::{
+        ClientEndpointId, ClientEndpointStatus, ProfileId, SavedSshEndpoint,
+    };
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    let profile = SavedSshEndpoint {
+        id: ProfileId::parse("0123456789abcdef0123456789abcdef").expect("profile id"),
+        label: "Build".into(),
+        target: "dev@build.example".into(),
+        session: "agents".into(),
+        enabled: true,
+    };
+    let remote = ClientEndpointId::Ssh(profile.id.clone());
+    state.set_endpoint_catalog(&[profile]);
+    state.set_endpoint_status(&remote, ClientEndpointStatus::Online);
+    state.set_snapshot(Box::new(tree_snapshot()));
+    state.set_pane_surface(surface());
+    let mut remote_snapshot = tree_snapshot();
+    remote_snapshot.boot_id = "remote-boot".into();
+    remote_snapshot.agents[1].agent_status = remote_status;
+    state.set_endpoint_snapshot(&remote, Box::new(remote_snapshot));
+    state.compose(106, 40).expect("frame");
+    (state, remote)
+}
+
+fn machine_line(
+    state: &ClientShellState,
+    endpoint: &crate::client::endpoint::ClientEndpointId,
+    pane_id: &str,
+) -> Rect {
+    state
+        .hits
+        .endpoint_agents
+        .iter()
+        .find(|(rect, id, pane)| {
+            id == endpoint && pane == pane_id && rect.y < state.hits.agent_body.y.max(1)
+        })
+        .or_else(|| {
+            state
+                .hits
+                .endpoint_agents
+                .iter()
+                .find(|(_, id, pane)| id == endpoint && pane == pane_id)
+        })
+        .map(|(rect, _, _)| *rect)
+        .expect("machine tree line")
+}
