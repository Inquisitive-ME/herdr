+#[test]
+fn waiting_agents_are_grouped_needs_input_then_finished() {
+    let mut snapshot = tree_snapshot();
+    // The focused agent counts as read, so the unread finished one is in another tab.
+    snapshot.agents[0].agent_status = AgentStatus::Blocked;
+    snapshot.agents[1].agent_status = AgentStatus::Working;
+    snapshot.agents[1].state_change_seq = 1;
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(Box::new(snapshot.clone()));
+    // The client marks an agent finished once it has seen it work and then stop.
+    snapshot.revision = 2;
+    snapshot.agents[1].agent_status = AgentStatus::Done;
+    snapshot.agents[1].state_change_seq = 2;
+    state.set_snapshot(Box::new(snapshot));
+    let mut surface = surface();
+    surface.projection_revision = 2;
+    state.set_pane_surface(surface);
+    let frame = state.compose(106, 30).expect("frame");
+    let sidebar = frame_rows(&frame)
+        .into_iter()
+        .map(|row| {
+            row.chars()
+                .take(24)
+                .collect::<String>()
+                .trim_end()
+                .to_owned()
+        })
+        .collect::<Vec<_>>();
+    let needs_input = sidebar
+        .iter()
+        .position(|row| row == " needs input")
+        .expect("title");
+    let finished = sidebar
+        .iter()
+        .position(|row| row == " finished")
+        .unwrap_or_else(|| panic!("{sidebar:#?}"));
+    assert!(needs_input < finished, "{sidebar:#?}");
+    // The blocked agent sits under "needs input", the finished one under "finished".
+    let blocked_row = state
+        .hits
+        .agents
+        .iter()
+        .filter(|(rect, id)| id == "pane_1" && rect.y > needs_input as u16)
+        .map(|(rect, _)| rect.y as usize)
+        .next()
+        .expect("blocked agent row");
+    let done_row = state
+        .hits
+        .agents
+        .iter()
+        .filter(|(rect, id)| id == "pane_2" && rect.y > needs_input as u16)
+        .map(|(rect, _)| rect.y as usize)
+        .next()
+        .expect("finished agent row");
+    assert!(
+        needs_input < blocked_row && blocked_row < finished && finished < done_row,
+        "{sidebar:#?}"
+    );
+}
