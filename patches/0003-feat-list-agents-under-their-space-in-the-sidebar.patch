+
+/// Client state behind the space tree's clicks, drags and ages.
+#[derive(Default)]
+pub(in crate::client::shell) struct SpaceTreeState {
+    press: Option<LinePress>,
+    drag: Option<LineDrag>,
+    /// Summary of the age labels last drawn, to repaint only when one changes.
+    age_marker: u64,
+}
+
+struct LinePress {
+    endpoint_id: ClientEndpointId,
+    pane_id: String,
+    column: u16,
+    row: u16,
+}
+
+struct LineDrag {
+    pane_id: String,
+    target: Option<LineDrop>,
+}
+
+/// Where a dragged line would go.
+#[derive(Debug, Clone, PartialEq, Eq)]
+enum LineDrop {
+    /// Into a new tab of another space.
+    Space { workspace_id: String },
+    /// Its tab takes the place of `target_pane_id`'s tab in the same space.
+    Tab {
+        target_pane_id: String,
+        tab_id: String,
+        insert_index: usize,
+    },
+}
+
+impl ClientShellState {
+    /// The space toggle or collapsed summary under `point`, as (endpoint, group key).
+    pub(super) fn space_toggle_at(&self, point: (u16, u16)) -> Option<(ClientEndpointId, String)> {
+        self.hits
+            .space_toggles
+            .iter()
+            .find(|(rect, _, _)| super::contains(*rect, point))
+            .map(|(_, endpoint_id, key)| (endpoint_id.clone(), key.clone()))
+    }
+
+    pub(super) fn press_space_line(
+        &mut self,
+        endpoint_id: ClientEndpointId,
+        pane_id: String,
+        column: u16,
+        row: u16,
+    ) {
+        self.space_tree.drag = None;
+        self.space_tree.press = Some(LinePress {
+            endpoint_id,
+            pane_id,
+            column,
+            row,
+        });
+    }
+
+    /// Release focuses the pressed line; moving first drags it to another space or tab
+    /// position. Returns whether the event belonged to a space-tree press.
+    pub(super) fn handle_space_line_drag(
+        &mut self,
+        mouse: MouseEvent,
+        outcome: &mut ClientShellInput,
+    ) -> bool {
+        let point = (mouse.column, mouse.row);
+        match mouse.kind {
+            MouseEventKind::Down(_) => {
+                self.space_tree.press = None;
+                self.space_tree.drag = None;
+                false
+            }
+            MouseEventKind::Drag(MouseButton::Left) => {
+                if let Some(pane_id) = self
+                    .space_tree
+                    .drag
+                    .as_ref()
+                    .map(|drag| drag.pane_id.clone())
+                {
+                    let target = self.space_line_drop_at(&pane_id, point);
+                    if let Some(drag) = self.space_tree.drag.as_mut() {
+                        drag.target = target;
+                    }
+                    outcome.repaint = true;
+                    return true;
+                }
+                let Some(press) = self.space_tree.press.as_ref() else {
+                    return false;
+                };
+                // Lines only move within the machine being shown; elsewhere, release still
+                // switches to the agent.
+                if (press.column == mouse.column && press.row == mouse.row)
+                    || press.endpoint_id != self.active_endpoint_id
+                {
+                    return true;
+                }
+                let pane_id = press.pane_id.clone();
+                self.space_tree.press = None;
+                let target = self.space_line_drop_at(&pane_id, point);
+                self.space_tree.drag = Some(LineDrag { pane_id, target });
+                outcome.repaint = true;
+                true
+            }
+            MouseEventKind::Up(MouseButton::Left) => {
+                if let Some(drag) = self.space_tree.drag.take() {
+                    if let Some(method) = self
+                        .space_line_drop_at(&drag.pane_id, point)
+                        .and_then(|target| self.space_line_drop_method(&drag.pane_id, target))
+                    {
+                        self.push_endpoint_method(method, outcome);
+                    }
+                    outcome.repaint = true;
+                    return true;
+                }
+                let Some(press) = self.space_tree.press.take() else {
+                    return false;
+                };
+                if self.multi_endpoint_active() {
+                    self.focus_or_activate(
+                        press.endpoint_id,
+                        ClientEndpointFocusTarget::Pane(press.pane_id),
+                        outcome,
+                    );
+                } else {
+                    self.push_endpoint_method(
+                        crate::api::schema::Method::PaneFocus(crate::api::schema::PaneTarget {
+                            pane_id: press.pane_id,
+                        }),
+                        outcome,
+                    );
+                }
+                true
+            }
+            _ => false,
+        }
+    }
+
+    /// Line hits of the machine being shown: the local sidebar's, or the active
+    /// machine's in the multi-machine sidebar.
+    fn active_lines(&self) -> impl Iterator<Item = (Rect, &str)> {
+        self.hits
+            .agents
+            .iter()
+            .map(|(rect, pane_id)| (*rect, pane_id.as_str()))
+            .chain(
+                self.hits
+                    .endpoint_agents
+                    .iter()
+                    .filter(|(_, endpoint_id, _)| *endpoint_id == self.active_endpoint_id)
+                    .map(|(rect, _, pane_id)| (*rect, pane_id.as_str())),
+            )
+    }
+
+    /// Whether a line hit sits in the space tree rather than the needs-input list.
+    fn in_space_tree(&self, rect: Rect) -> bool {
+        let corner = (rect.x, rect.y);
+        super::contains(self.hits.workspace_body, corner)
+            && !super::contains(self.hits.agent_body, corner)
+    }
+
+    fn space_line_drop_at(&self, pane_id: &str, point: (u16, u16)) -> Option<LineDrop> {
+        let snapshot = self.snapshot.as_deref()?;
+        let source = snapshot.panes.iter().find(|pane| pane.pane_id == pane_id)?;
+        let into_space = |workspace_id: &str| {
+            (workspace_id != source.workspace_id).then(|| LineDrop::Space {
+                workspace_id: workspace_id.to_owned(),
+            })
+        };
+        if let Some(hit) = self.hits.workspaces.iter().find(|hit| {
+            hit.endpoint_id == self.active_endpoint_id && super::contains(hit.rect, point)
+        }) {
+            return into_space(&hit.workspace_id);
+        }
+        if let Some(workspace_id) = self.space_toggle_at(point).and_then(|(endpoint_id, key)| {
+            (endpoint_id == self.active_endpoint_id)
+                .then(|| key.strip_prefix(COLLAPSED_KEY_PREFIX).map(str::to_owned))
+                .flatten()
+        }) {
+            return into_space(&workspace_id);
+        }
+        let (_, target_pane_id) = self
+            .active_lines()
+            .find(|(rect, _)| super::contains(*rect, point) && self.in_space_tree(*rect))?;
+        let target = snapshot
+            .panes
+            .iter()
+            .find(|pane| pane.pane_id == target_pane_id)?;
+        if target.workspace_id != source.workspace_id {
+            return into_space(&target.workspace_id);
+        }
+        let tabs = snapshot
+            .tabs
+            .iter()
+            .filter(|tab| tab.workspace_id == source.workspace_id)
+            .map(|tab| tab.tab_id.as_str())
+            .collect::<Vec<_>>();
+        let from = tabs.iter().position(|tab_id| *tab_id == source.tab_id)?;
+        let to = tabs.iter().position(|tab_id| *tab_id == target.tab_id)?;
+        (from != to).then(|| LineDrop::Tab {
+            target_pane_id: target.pane_id.clone(),
+            tab_id: source.tab_id.clone(),
+            insert_index: if to > from { to + 1 } else { to },
+        })
+    }
+
+    fn space_line_drop_method(
+        &self,
+        pane_id: &str,
+        target: LineDrop,
+    ) -> Option<crate::api::schema::Method> {
+        use crate::api::schema::{Method, TabMoveParams};
+        match target {
+            LineDrop::Space { workspace_id } => self.move_pane_method(pane_id, Some(workspace_id)),
+            LineDrop::Tab {
+                tab_id,
+                insert_index,
+                ..
+            } => Some(Method::TabMove(TabMoveParams {
+                tab_id,
+                insert_index,
+            })),
+        }
+    }
+
+    /// Move a pane into a new tab of `workspace_id`, or into a new space when `None`.
+    /// A tab named by hand keeps its name when its only pane moves.
+    fn move_pane_method(
+        &self,
+        pane_id: &str,
+        workspace_id: Option<String>,
+    ) -> Option<crate::api::schema::Method> {
+        use crate::api::schema::{Method, PaneMoveDestination, PaneMoveParams};
+        let snapshot = self.snapshot.as_deref()?;
+        let pane = snapshot.panes.iter().find(|pane| pane.pane_id == pane_id)?;
+        let alone = snapshot
+            .panes
+            .iter()
+            .filter(|other| other.tab_id == pane.tab_id)
+            .count()
+            == 1;
+        let label = snapshot
+            .tabs
+            .iter()
+            .find(|tab| tab.tab_id == pane.tab_id && tab.custom_label && alone)
+            .map(|tab| tab.label.clone());
+        let destination = match workspace_id {
+            Some(workspace_id) => PaneMoveDestination::NewTab {
+                workspace_id: Some(workspace_id),
+                label,
+            },
+            None => PaneMoveDestination::NewWorkspace {
+                label: label.clone(),
+                tab_label: label,
+            },
+        };
+        Some(Method::PaneMove(PaneMoveParams {
+            pane_id: pane_id.to_owned(),
+            destination,
+            focus: pane.focused,
+        }))
+    }
+
+    /// Dim the dragged line and shade where it would land.
+    pub(super) fn paint_space_line_drag(&self, buffer: &mut Buffer) {
+        let Some(drag) = self.space_tree.drag.as_ref() else {
+            return;
+        };
+        for (rect, pane_id) in self.active_lines() {
+            if pane_id == drag.pane_id {
+                buffer.set_style(rect, Style::default().add_modifier(Modifier::DIM));
+            }
+        }
+        let target = match drag.target.as_ref() {
+            Some(LineDrop::Space { workspace_id }) => self
+                .hits
+                .workspaces
+                .iter()
+                .find(|hit| {
+                    hit.endpoint_id == self.active_endpoint_id && hit.workspace_id == *workspace_id
+                })
+                .map(|hit| hit.rect),
+            Some(LineDrop::Tab { target_pane_id, .. }) => self
+                .active_lines()
+                .find(|(rect, pane_id)| pane_id == target_pane_id && self.in_space_tree(*rect))
+                .map(|(rect, _)| rect),
+            None => None,
+        };
+        if let Some(rect) = target {
+            buffer.set_style(rect, Style::default().bg(self.config.palette.surface1));
+        }
+    }
+
+    /// Open the space-line menu for the line under (x, y), on the machine being shown.
+    pub(super) fn open_space_line_menu_at(&mut self, x: u16, y: u16) -> bool {
+        let Some(pane_id) = self
+            .active_lines()
+            .find(|(rect, _)| super::contains(*rect, (x, y)))
+            .map(|(_, pane_id)| pane_id.to_owned())
+        else {
+            return false;
+        };
+        let Some(snapshot) = self.snapshot.as_deref() else {
+            return false;
+        };
+        let Some(pane) = snapshot.panes.iter().find(|pane| pane.pane_id == pane_id) else {
+            return false;
+        };
+        let destinations = super::sidebar::workspace_entries(snapshot, &HashSet::new())
+            .iter()
+            .filter_map(|entry| snapshot.workspaces.get(entry.index))
+            .filter(|workspace| workspace.workspace_id != pane.workspace_id)
+            .map(|workspace| (workspace.workspace_id.clone(), workspace.label.clone()))
+            .collect();
+        self.overlay = Some(ClientShellOverlay::ContextMenu(ClientContextMenuOverlay {
+            target: ClientContextMenuTarget::SpaceLine {
+                pane_id,
+                destinations,
+            },
+            x,
+            y,
+            highlighted: 0,
+        }));
+        true
+    }
+
+    pub(super) fn activate_space_line_action(
+        &mut self,
+        pane_id: String,
+        destinations: Vec<(String, String)>,
+        action: ClientContextMenuAction,
+        outcome: &mut ClientShellInput,
+    ) {
+        match action {
+            ClientContextMenuAction::Rename => {
+                let tab = self.snapshot.as_deref().and_then(|snapshot| {
+                    let pane = snapshot.panes.iter().find(|pane| pane.pane_id == pane_id)?;
+                    snapshot.tabs.iter().find(|tab| tab.tab_id == pane.tab_id)
+                });
+                if let Some(tab) = tab {
+                    self.overlay = Some(ClientShellOverlay::Rename(ClientRenameOverlay {
+                        title: "rename tab",
+                        input: TextEditor::new(&tab.label, false),
+                        target: ClientRenameTarget::Tab {
+                            tab_id: tab.tab_id.clone(),
+                            auto_name: !tab.custom_label,
+                            original_name: tab.label.clone(),
+                        },
+                    }));
+                }
+            }
+            ClientContextMenuAction::MoveToSpace(index) => {
+                let method = destinations
+                    .into_iter()
+                    .nth(index)
+                    .and_then(|(workspace_id, _)| {
+                        self.move_pane_method(&pane_id, Some(workspace_id))
+                    });
+                if let Some(method) = method {
+                    self.push_endpoint_method(method, outcome);
+                }
+            }
+            ClientContextMenuAction::MoveToNewSpace => {
+                if let Some(method) = self.move_pane_method(&pane_id, None) {
+                    self.push_endpoint_method(method, outcome);
+                }
+            }
+            ClientContextMenuAction::ClosePane => self.request_pane_close(pane_id, outcome),
+            _ => {}
+        }
+    }
+
+    /// Repaint when any agent's age label would change ("1m" to "2m", "59m" to "1h").
+    pub(crate) fn tick_space_clock(&mut self) -> bool {
+        let now_ms = now_unix_ms();
+        let snapshots = self.snapshot.as_deref().into_iter().chain(
+            self.endpoints
+                .iter()
+                .filter_map(|endpoint| endpoint.snapshot.as_deref()),
+        );
+        let mut marker = 0u64;
+        for agent in snapshots.flat_map(|snapshot| snapshot.agents.iter()) {
+            let age = state_age_minutes(agent, now_ms).map_or(0, age_label_bucket);
+            marker = marker.wrapping_mul(1_000_003).wrapping_add(age);
+        }
+        if marker == self.space_tree.age_marker {
+            return false;
+        }
+        self.space_tree.age_marker = marker;
+        true
+    }
+}
