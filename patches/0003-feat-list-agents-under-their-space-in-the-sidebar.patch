+        let mut snapshot = fridge();
+        assert_eq!(tree_agent_pane_ids(&snapshot), ["p1", "p2", "p5"]);
+        assert_eq!(agent_cycle(&snapshot), ["p2", "p5"]);
+        // With nobody blocked, unread finished agents come next.
+        for agent in &mut snapshot.agents {
+            if agent.agent_status == AgentStatus::Blocked {
+                agent.agent_status = AgentStatus::Working;
+            }
+        }
+        assert_eq!(agent_cycle(&snapshot), ["p1"]);
+        for agent in &mut snapshot.agents {
+            agent.agent_status = AgentStatus::Working;
+        }
+        assert_eq!(agent_cycle(&snapshot), ["p1", "p2", "p5"]);
