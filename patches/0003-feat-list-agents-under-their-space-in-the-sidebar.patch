+//! Fork: mouse behavior of the space tree in the expanded sidebar.
+
+use super::*;
+use crate::api::schema::{Method, PaneMoveDestination};
+
+fn tree_snapshot() -> ClientShellSnapshot {
+    let mut snapshot = snapshot();
+    let mut second = snapshot.workspaces[0].clone();
+    second.workspace_id = "ws_2".into();
+    second.label = "personal".into();
+    second.focused = false;
+    snapshot.workspaces.push(second);
+    let mut tab_2 = snapshot.tabs[0].clone();
+    tab_2.tab_id = "tab_2".into();
+    tab_2.label = "deploy".into();
+    tab_2.custom_label = true;
+    tab_2.focused = false;
+    let mut tab_3 = tab_2.clone();
+    tab_3.tab_id = "tab_3".into();
+    tab_3.workspace_id = "ws_2".into();
+    tab_3.label = "server".into();
+    snapshot.tabs.extend([tab_2, tab_3]);
+    let mut pane_2 = snapshot.panes[0].clone();
+    pane_2.pane_id = "pane_2".into();
+    pane_2.tab_id = "tab_2".into();
+    pane_2.focused = false;
+    let mut pane_3 = pane_2.clone();
+    pane_3.pane_id = "pane_3".into();
+    pane_3.tab_id = "tab_3".into();
+    pane_3.workspace_id = "ws_2".into();
+    snapshot.panes.extend([pane_2, pane_3]);
+    let agent = |pane_id: &str, tab_id: &str, status| ClientShellAgent {
+        pane_id: pane_id.into(),
+        workspace_id: "ws_1".into(),
+        tab_id: tab_id.into(),
+        name: None,
+        display_agent: None,
+        agent: Some("claude".into()),
+        title: None,
+        terminal_title: None,
+        terminal_title_stripped: None,
+        agent_status: status,
+        state_change_seq: 0,
+        state_labels: Vec::new(),
+        tokens: Vec::new(),
+        focused: pane_id == "pane_1",
+    };
+    snapshot.agents = vec![
+        agent("pane_1", "tab_1", AgentStatus::Idle),
+        agent("pane_2", "tab_2", AgentStatus::Working),
+    ];
+    snapshot
+}
+
+fn tree_state() -> ClientShellState {
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(Box::new(tree_snapshot()));
+    state.set_pane_surface(surface());
+    state.compose(106, 30).expect("frame");
+    state
+}
+
+fn mouse(state: &mut ClientShellState, kind: MouseEventKind, at: Rect) -> ClientShellInput {
+    state.handle_raw_events(vec![RawInputEvent::Mouse(MouseEvent {
+        kind,
+        column: at.x + 4,
+        row: at.y,
+        modifiers: KeyModifiers::empty(),
+    })])
