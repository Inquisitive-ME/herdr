@@ -572,7 +572,7 @@ impl ClientShellState {
                     .get(entry.index)
                     .map(|workspace| workspace.workspace_id.clone())
             });
-            let row = last_hit.rect.bottom();
+            let row = self.space_end(last_hit);
             if row < self.hits.new_workspace.y {
                 slots.push((before, row));
             }
