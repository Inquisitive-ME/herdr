--- a/src/client/shell/endpoint_sidebar.rs
+++ b/src/client/shell/endpoint_sidebar.rs
@@ -587,6 +587,11 @@ pub(super) fn render_expanded(
                     indented: entry.indented,
                     group_toggle,
                 });
+                hits.space_ends.push((
+                    endpoint.endpoint_id.clone(),
+                    workspace.workspace_id.clone(),
+                    inner.bottom(),
+                ));
                 let gap = gaps
                     .get(row_index)
                     .copied()
