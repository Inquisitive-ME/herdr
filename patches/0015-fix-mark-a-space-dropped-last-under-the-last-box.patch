         .count();
     assert_eq!(shaded, 1);
 }
+
+#[test]
+fn a_space_dropped_last_marks_the_bottom_of_the_last_box() {
+    let mut state = tree_state();
+    let first = state.hits.workspaces[0].rect;
+    let last_line = line(&state, "pane_3");
+    let bottom = last_line.bottom();
+    let frame = state.compose(106, 30).expect("frame");
+    assert_eq!(cell(&frame, state.hits.workspace_body.x, bottom), "╰");
+
+    mouse(&mut state, MouseEventKind::Down(MouseButton::Left), first);
+    mouse(
+        &mut state,
+        MouseEventKind::Drag(MouseButton::Left),
+        last_line,
+    );
+    assert!(matches!(
+        state.chrome_drag,
+        Some(ClientChromeDrag::Workspace {
+            target: Some((None, row)),
+            ..
+        }) if row == bottom
+    ));
+    // The marker replaces the box's bottom edge, not the last tab's line.
+    let frame = state.compose(106, 30).expect("frame");
+    assert_eq!(cell(&frame, state.hits.workspace_body.x, bottom), "─");
+    assert_eq!(cell(&frame, last_line.x + 1, last_line.y), "$");
+}
