diff --git a/src/client/shell/space_agents.rs b/src/client/shell/space_agents.rs
index a384b371..74954854 100644
--- a/src/client/shell/space_agents.rs
+++ b/src/client/shell/space_agents.rs
@@ -1398,6 +1398,17 @@ impl ClientShellState {
         }
     }
 
+    /// The row just below a space's tree, where a space dropped after it would go.
+    pub(super) fn space_end(&self, hit: &WorkspaceHit) -> u16 {
+        self.hits
+            .space_ends
+            .iter()
+            .find(|(endpoint_id, workspace_id, _)| {
+                *endpoint_id == hit.endpoint_id && *workspace_id == hit.workspace_id
+            })
+            .map_or(hit.rect.bottom(), |(_, _, row)| *row)
+    }
+
     /// Dim the dragged line and shade where it would land.
     pub(super) fn paint_space_line_drag(&self, buffer: &mut Buffer) {
         let Some(drag) = self.space_tree.drag.as_ref() else {
