From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Richard Swanson <rswanson05@gmail.com>
Date: Sun, 8 Nov 2026 07:46:29 -0600
Subject: [PATCH] feat: show agent ages only while working or waiting

Idle and finished agents no longer show how long they have been idle; the age now means running for or waiting for.

diff --git a/src/client/shell/space_agents.rs b/src/client/shell/space_agents.rs
index 5ec06eaf..5a6a7449 100644
--- a/src/client/shell/space_agents.rs
+++ b/src/client/shell/space_agents.rs
@@ -426,7 +426,7 @@ fn shell_count_text(agent: &ClientShellAgent) -> Option<String> {
     ))
 }
 
-/// How long an agent has been in its state, from the server's `state_since_ms` token:
+/// How long an active agent has been working or waiting, from the `state_since_ms` token:
 /// "12m", "3h", "2d". Nothing under a minute.
 fn state_age_text(agent: &ClientShellAgent, now_ms: u64) -> Option<String> {
     let minutes = state_age_minutes(agent, now_ms)?;
@@ -438,8 +438,13 @@ fn state_age_text(agent: &ClientShellAgent, now_ms: u64) -> Option<String> {
     }
 }
 
+/// Minutes an active agent has been running or waiting on the user. Idle and finished
+/// agents have no age: how long something has sat idle isn't worth the space.
 fn state_age_minutes(agent: &ClientShellAgent, now_ms: u64) -> Option<u64> {
-    if agent.agent_status == AgentStatus::Unknown {
+    if !matches!(
+        agent.agent_status,
+        AgentStatus::Working | AgentStatus::Blocked
+    ) {
         return None;
     }
     let since = agent
@@ -1518,8 +1523,15 @@ mod tests {
         );
         // Clock skew between machines never shows a negative age.
         assert_eq!(state_age_text(&agent, since - 5_000), None);
-        agent.agent_status = AgentStatus::Unknown;
-        assert_eq!(state_age_text(&agent, since + 12 * 60_000), None);
+        agent.agent_status = AgentStatus::Blocked;
+        assert_eq!(
+            state_age_text(&agent, since + 12 * 60_000).as_deref(),
+            Some("12m")
+        );
+        for status in [AgentStatus::Idle, AgentStatus::Done, AgentStatus::Unknown] {
+            agent.agent_status = status;
+            assert_eq!(state_age_text(&agent, since + 12 * 60_000), None);
+        }
         assert_eq!(state_age_text(&agent_with_tokens(&[]), since), None);
     }
 
