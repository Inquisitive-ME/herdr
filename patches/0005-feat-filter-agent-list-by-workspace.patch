From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Richard Swanson <rswanson05@gmail.com>
Date: Mon, 9 Nov 2026 14:56:47 -0600
Subject: [PATCH] feat: filter agent list by workspace

herdr agent list --workspace <id> lists only the agents in that
workspace, the way herdr tab list --workspace already filters tabs. An
agent can pass $HERDR_WORKSPACE_ID to see the other agents in its own
space. The CLI filters the server's full list, so it works against
servers of any version.

diff --git a/src/cli/agent.rs b/src/cli/agent.rs
index 09043460..e2be7813 100644
--- a/src/cli/agent.rs
+++ b/src/cli/agent.rs
@@ -436,15 +436,29 @@ fn agent_start(args: &[String]) -> std::io::Result<i32> {
 }
 
 fn agent_list(args: &[String]) -> std::io::Result<i32> {
-    if !args.is_empty() {
-        eprintln!("usage: herdr agent list");
-        return Ok(2);
-    }
+    let workspace_id = match args {
+        [] => None,
+        [flag, value] if flag == "--workspace" => Some(super::normalize_workspace_id(value)),
+        _ => {
+            eprintln!("usage: herdr agent list [--workspace <workspace_id>]");
+            return Ok(2);
+        }
+    };
 
-    super::print_response(&super::send_request(&Request {
+    let mut response = super::send_request(&Request {
         id: "cli:agent:list".into(),
         method: Method::AgentList(EmptyParams::default()),
-    })?)
+    })?;
+    // Fork: filtered here rather than by the server, so it works against any server.
+    if let Some(workspace_id) = workspace_id {
+        if let Some(agents) = response
+            .pointer_mut("/result/agents")
+            .and_then(serde_json::Value::as_array_mut)
+        {
+            agents.retain(|agent| agent["workspace_id"] == workspace_id.as_str());
+        }
+    }
+    super::print_response(&response)
 }
 
 fn agent_get(args: &[String]) -> std::io::Result<i32> {
@@ -931,7 +945,7 @@ fn agent_read(args: &[String]) -> std::io::Result<i32> {
 
 fn print_agent_help() {
     eprintln!("herdr agent commands:");
-    eprintln!("  herdr agent list");
+    eprintln!("  herdr agent list [--workspace <workspace_id>]");
     eprintln!("  herdr agent get <target>");
     eprintln!("  herdr agent read <target> [--source visible|recent|recent-unwrapped|detection] [--lines N] [--format text|ansi] [--ansi]");
     eprintln!("  herdr agent send-keys <target> <key> [key ...]");
