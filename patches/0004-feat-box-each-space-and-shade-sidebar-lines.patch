+    /// Light up the line under the mouse. Only plain and shaded cells change, so the
+    /// focused tab's and space's highlight (and a selection) stay as they are. Off while
+    /// dragging, which draws its own drop marks, and, like the shading, when the
+    /// terminal doesn't report its background.
+    pub(super) fn paint_sidebar_hover(&self, buffer: &mut Buffer) {
+        if self.chrome_drag.is_some() || self.space_tree.drag.is_some() {
+            return;
+        }
+        let plain = self.config.palette.sidebar_bg;
+        let (Some(rect), Some(hover)) = (
+            self.hovered_line(),
+            sidebar_tint(plain, self.host_background, HOVER_PERCENT),
+        ) else {
+            return;
+        };
+        let shade = sidebar_tint(plain, self.host_background, TAB_BAND_PERCENT);
+        for y in rect.y..rect.bottom() {
+            for x in rect.x..rect.right() {
+                if let Some(cell) = buffer
+                    .cell_mut((x, y))
+                    .filter(|cell| cell.bg == plain || Some(cell.bg) == shade)
