+        let widest = rows
+            .iter()
+            .map(|(_, value)| UnicodeWidthStr::width(value.as_str()))
+            .max()
+            .unwrap_or(0);
+        let width = u16::try_from(widest + CHROME)
+            .unwrap_or(u16::MAX)
+            .min(area.width);
+        let height = rows.len() as u16 + 2;
+        if rows.is_empty() || usize::from(width) < CHROME + 6 || height > area.height {
+            return;
+        }
+        let y = line.y.clamp(area.y, area.bottom() - height);
+        let rect = Rect::new(area.x, y, width, height);
+        let Some(mut buffer) = frame.to_ratatui_buffer() else {
+            return;
