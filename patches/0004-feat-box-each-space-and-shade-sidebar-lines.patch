+#[test]
+fn the_line_under_the_mouse_lights_up_but_the_focused_tab_keeps_its_highlight() {
+    let mut state = tree_state();
+    state.host_background = Some(crate::terminal_theme::RgbColor {
+        r: 0x23,
+        g: 0x26,
+        b: 0x27,
+    });
+    let palette = state.config.palette.clone();
+    let hover = ratatui::style::Color::Rgb(61, 64, 64);
+    let shade = ratatui::style::Color::Rgb(48, 51, 51);
+    let bg = |state: &mut ClientShellState, rect: Rect| {
+        let frame = state.compose(106, 30).expect("frame");
+        frame.to_ratatui_buffer().expect("buffer")[(rect.right() - 1, rect.y)].bg
+    };
+    let focused = line(&state, "pane_1");
+    let deploy = line(&state, "pane_2");
+    let personal = state.hits.workspaces[1].rect;
+    assert_eq!(bg(&mut state, deploy), shade);
+
+    assert!(mouse(&mut state, MouseEventKind::Moved, deploy).repaint);
+    assert_eq!(bg(&mut state, deploy), hover);
+    // Moving within the same line doesn't repaint.
+    let along = Rect {
+        x: deploy.x + 1,
+        ..deploy
+    };
+    assert!(!mouse(&mut state, MouseEventKind::Moved, along).repaint);
+
+    // The focused tab and space keep their own highlight under the mouse.
+    let focused_space = state.hits.workspaces[0].rect;
+    mouse(&mut state, MouseEventKind::Moved, focused);
+    assert_eq!(bg(&mut state, focused), palette.active_row_bg);
+    mouse(&mut state, MouseEventKind::Moved, focused_space);
+    assert_eq!(bg(&mut state, focused_space), palette.active_row_bg);
+
+    mouse(&mut state, MouseEventKind::Moved, personal);
+    assert_eq!(bg(&mut state, personal), hover);
+    assert_eq!(bg(&mut state, deploy), shade);
+
+    // Off the sidebar nothing is lit.
+    let pane = state.hits.panes[0].inner_rect;
+    assert!(mouse(&mut state, MouseEventKind::Moved, pane).repaint);
+    assert_eq!(bg(&mut state, personal), palette.sidebar_bg);
+}
