 /// Draw a group heading on the second line of its two-line entry.
+/// Make room left of an attention row for the agent's number from the space tree, in
+/// the same column, and return the rest for the row. `number` is `None` when agents
+/// aren't numbered (the row keeps its usual place) and `Some(None)` for an agent past 9.
+pub(in crate::client::shell) fn render_attention_number(
+    buffer: &mut Buffer,
+    rect: Rect,
+    gutter: u16,
+    number: Option<Option<usize>>,
+    focused: bool,
+    palette: &Palette,
+) -> Rect {
+    let Some(number) = number.filter(|_| rect.width > gutter) else {
+        return rect;
+    };
+    let margin = Rect::new(rect.x, rect.y, gutter, rect.height);
+    if focused {
+        buffer.set_style(margin, Style::default().bg(palette.active_row_bg));
+    }
+    if let Some(index) = number {
+        put_text(
+            buffer,
+            rect.x + gutter - 1,
+            rect.y,
+            1,
+            &(index + 1).to_string(),
+            Style::default().fg(palette.overlay0),
+        );
+    }
+    Rect::new(rect.x + gutter, rect.y, rect.width - gutter, rect.height)
+}
