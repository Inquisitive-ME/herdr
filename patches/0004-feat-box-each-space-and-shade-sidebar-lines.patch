+#[test]
+fn hovering_a_tab_line_shows_its_folder_and_branch_beside_the_sidebar() {
+    let mut snapshot = tree_snapshot();
+    snapshot.panes[1].foreground_cwd = Some("/home/me/fridge/backend".into());
+    snapshot.panes[2].foreground_cwd = Some("/Users/me/notes".into());
+    snapshot.agents[1].tokens = vec![("git_branch".into(), "feature/card".into())];
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(Box::new(snapshot));
+    state.set_pane_surface(surface());
+    state.compose(106, 30).expect("frame");
+    // Where `text` starts in the frame, by cells.
+    let find = |frame: &FrameData, text: &str| {
+        let chars = text.chars().map(String::from).collect::<Vec<_>>();
+        (0..frame.height).find_map(|y| {
+            (0..frame.width.saturating_sub(chars.len() as u16))
+                .find(|x| {
+                    chars
+                        .iter()
+                        .enumerate()
+                        .all(|(i, ch)| cell(frame, x + i as u16, y) == ch)
+                })
+                .map(|x| (x, y))
+        })
+    };
+    let sidebar_right = state.hits.workspace_body.right();
+
+    let deploy = line(&state, "pane_2");
+    assert!(mouse(&mut state, MouseEventKind::Moved, deploy).repaint);
+    let frame = state.compose(106, 30).expect("frame");
+    let (x, y) = find(&frame, "folder  ~/fridge/backend").expect("folder row");
+    assert!(x >= sidebar_right);
+    assert_eq!(find(&frame, "branch  feature/card"), Some((x, y + 1)));
+
+    // A plain terminal has no branch to report.
+    let server = line(&state, "pane_3");
+    mouse(&mut state, MouseEventKind::Moved, server);
+    let frame = state.compose(106, 30).expect("frame");
+    assert!(find(&frame, "folder  ~/notes").is_some());
+    assert_eq!(find(&frame, "branch"), None);
+
+    let pane = state.hits.panes[0].inner_rect;
+    mouse(&mut state, MouseEventKind::Moved, pane);
+    let frame = state.compose(106, 30).expect("frame");
+    assert_eq!(find(&frame, "folder"), None);
+}
