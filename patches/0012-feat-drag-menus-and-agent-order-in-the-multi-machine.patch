+#[test]
+fn multi_machine_lines_drag_within_the_machine_being_shown() {
+    let (mut state, _) = multi_machine_state(AgentStatus::Working);
+    let local = crate::client::endpoint::ClientEndpointId::Local;
+    let source = machine_line(&state, &local, "pane_2");
+    let destination = state
+        .hits
+        .workspaces
+        .iter()
+        .find(|hit| hit.endpoint_id == local && hit.workspace_id == "ws_2")
+        .map(|hit| hit.rect)
+        .expect("local personal space");
+    mouse(&mut state, MouseEventKind::Down(MouseButton::Left), source);
+    mouse(
+        &mut state,
+        MouseEventKind::Drag(MouseButton::Left),
+        destination,
+    );
+    let up = mouse(
+        &mut state,
+        MouseEventKind::Up(MouseButton::Left),
+        destination,
+    );
+    assert!(matches!(
+        methods(&up)[..],
+        [Method::PaneMove(params)] if params.pane_id == "pane_2"
+    ));
+}
+
+#[test]
+fn multi_machine_click_switches_to_another_machines_agent_on_release() {
+    let (mut state, remote) = multi_machine_state(AgentStatus::Working);
+    let target = machine_line(&state, &remote, "pane_2");
+    let down = mouse(&mut state, MouseEventKind::Down(MouseButton::Left), target);
+    assert!(down.actions.is_empty());
+    // Dragging another machine's line does nothing; release still switches to it.
+    mouse(
+        &mut state,
+        MouseEventKind::Drag(MouseButton::Left),
+        Rect {
+            y: target.y + 1,
+            ..target
+        },
+    );
+    let up = mouse(
+        &mut state,
+        MouseEventKind::Up(MouseButton::Left),
+        Rect {
+            y: target.y + 1,
+            ..target
+        },
+    );
+    assert!(matches!(
+        up.actions.as_slice(),
+        [ClientShellAction::ActivateEndpoint {
+            endpoint_id,
+            target: Some(ClientEndpointFocusTarget::Pane(pane)),
+        }] if *endpoint_id == remote && pane == "pane_2"
+    ));
+}
+
+#[test]
+fn multi_machine_next_agent_goes_to_the_most_urgent_across_machines() {
+    let (mut state, remote) = multi_machine_state(AgentStatus::Blocked);
+    let mut outcome = ClientShellInput::default();
+    assert!(state.handle_endpoint_navigation(crate::input::KeybindAction::NextAgent, &mut outcome));
+    assert!(matches!(
+        outcome.actions.as_slice(),
+        [ClientShellAction::ActivateEndpoint {
+            endpoint_id,
+            target: Some(ClientEndpointFocusTarget::Pane(pane)),
+        }] if *endpoint_id == remote && pane == "pane_2"
+    ));
+    // focus_agent numbers follow the tree: Local's two agents, then Build's.
+    let targets = crate::client::shell::space_agents::endpoint_focus_targets(&state.endpoints);
+    let order = targets
+        .iter()
+        .map(|target| (target.endpoint_id == remote, target.pane_id.as_str()))
+        .collect::<Vec<_>>();
+    assert_eq!(
+        order,
+        [
+            (false, "pane_1"),
+            (false, "pane_2"),
+            (true, "pane_1"),
+            (true, "pane_2")
+        ]
+    );
+}
