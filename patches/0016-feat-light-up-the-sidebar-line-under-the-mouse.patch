+    /// The clickable sidebar line under the mouse: a machine, a space, a tree line, a
+    /// collapsed summary or a waiting agent.
+    fn hovered_line(&self) -> Option<Rect> {
+        let point = self.space_tree.hover?;
+        self.hits
+            .machines
+            .iter()
+            .map(|hit| hit.rect)
+            .chain(self.hits.workspaces.iter().map(|hit| hit.rect))
+            .chain(self.hits.agents.iter().map(|(rect, _)| *rect))
+            .chain(self.hits.endpoint_agents.iter().map(|(rect, _, _)| *rect))
+            .chain(self.hits.space_toggles.iter().map(|(rect, _, _)| *rect))
+            .find(|rect| super::contains(*rect, point))
+    }
+
+    pub(super) fn update_sidebar_hover(
+        &mut self,
+        mouse: MouseEvent,
+        outcome: &mut ClientShellInput,
+    ) {
+        let before = self.hovered_line();
+        self.space_tree.hover = Some((mouse.column, mouse.row));
+        outcome.repaint |= self.hovered_line() != before;
+    }
+
+    /// Light up the line under the mouse. Only plain and shaded cells change, so the
+    /// focused tab's and space's highlight (and a selection) stay as they are. Off while
+    /// dragging, which draws its own drop marks, and, like the shading, when the
+    /// terminal doesn't report its background.
+    pub(super) fn paint_sidebar_hover(&self, buffer: &mut Buffer) {
+        if self.chrome_drag.is_some() || self.space_tree.drag.is_some() {
+            return;
+        }
+        let plain = self.config.palette.sidebar_bg;
+        let (Some(rect), Some(hover)) = (
+            self.hovered_line(),
+            sidebar_tint(plain, self.host_background, HOVER_PERCENT),
+        ) else {
+            return;
+        };
+        let shade = sidebar_tint(plain, self.host_background, TAB_BAND_PERCENT);
+        for y in rect.y..rect.bottom() {
+            for x in rect.x..rect.right() {
+                if let Some(cell) = buffer
+                    .cell_mut((x, y))
+                    .filter(|cell| cell.bg == plain || Some(cell.bg) == shade)
+                {
+                    cell.set_bg(hover);
+                }
+            }
+        }
+    }
+
