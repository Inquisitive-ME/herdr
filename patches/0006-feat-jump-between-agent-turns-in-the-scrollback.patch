diff --git a/src/pane/turn_marks.rs b/src/pane/turn_marks.rs
new file mode 100644
index 00000000..5d256865
--- /dev/null
+++ b/src/pane/turn_marks.rs
@@ -0,0 +1,408 @@
+//! Fork: marks in a pane's scrollback where an agent finished a turn and where the
+//! user's next message began, so the view can jump between them.
+
+use crate::ghostty::{ActiveScreen, CellWide, ScreenTextRow, Terminal, TrackedRow};
+
+/// Marks kept per pane; the oldest go first.
+const MAX_MARKS: usize = 2000;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum MarkKind {
+    /// Where the agent's answer ended.
+    TurnEnd,
+    /// Where one of the user's messages began.
+    Input,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum MarkDirection {
+    Previous,
+    Next,
+}
+
+struct TurnMark {
+    row: TrackedRow,
+    /// The agent went idle here after working or waiting (not on first detection).
+    turn_end: bool,
+    /// The user's next message was printed from here.
+    input: bool,
+}
+
+#[derive(Default)]
+pub(crate) struct TurnMarks {
+    marks: Vec<TurnMark>,
+    typed: bool,
+}
+
+impl TurnMarks {
+    /// Keys were typed into the pane.
+    pub(crate) fn note_typed(&mut self) {
+        self.typed = true;
+    }
+
+    /// The agent went idle. Marks the top of its prompt area: where its answer ended,
+    /// and where the user's next message will be printed.
+    pub(crate) fn mark_idle(&mut self, terminal: &mut Terminal, turn_end: bool) {
+        self.typed = false;
+        if !matches!(terminal.active_screen(), Ok(ActiveScreen::Primary)) {
+            return;
+        }
+        let Some(y) = prompt_area_top(terminal) else {
+            return;
+        };
+        if let Some(last) = self.marks.last_mut() {
+            if terminal.tracked_screen_row(&last.row) == Some(y) {
+                last.turn_end |= turn_end;
+                return;
+            }
+        }
+        let Some(row) = terminal.track_screen_row(y) else {
+            return;
+        };
+        self.marks.push(TurnMark {
+            row,
+            turn_end,
+            input: false,
+        });
+        if self.marks.len() > MAX_MARKS {
+            self.marks.remove(0);
+        }
+    }
+
+    /// The agent started working after being idle. If the user typed in between,
+    /// their message begins at the last mark.
+    pub(crate) fn mark_working(&mut self) {
+        if std::mem::take(&mut self.typed) {
+            if let Some(last) = self.marks.last_mut() {
+                last.input = true;
+            }
+        }
+    }
+
+    /// The scroll offset (rows from the bottom) showing the previous or next mark of
+    /// `kind`: a turn's end at the bottom of the view, a message's start at the top.
+    /// Next after the last mark is the live bottom; previous before the first is None.
+    pub(crate) fn offset_for(
+        &mut self,
+        terminal: &Terminal,
+        kind: MarkKind,
+        direction: MarkDirection,
+    ) -> Option<usize> {
+        self.marks
+            .retain(|mark| terminal.tracked_screen_row(&mark.row).is_some());
+        let scrollbar = terminal.scrollbar().ok()?;
+        let max = scrollbar.total.saturating_sub(scrollbar.len);
+        let current = max.saturating_sub(scrollbar.offset);
+        let newest = self.marks.len().saturating_sub(1);
+        let offsets = self
+            .marks
+            .iter()
+            .enumerate()
+            .filter(|(index, mark)| match kind {
+                // The newest turn's end sits right above the prompt until it's answered.
+                MarkKind::TurnEnd => mark.turn_end && (mark.input || *index != newest),
+                MarkKind::Input => mark.input,
+            })
+            .filter_map(|(_, mark)| terminal.tracked_screen_row(&mark.row))
+            .map(|row| {
+                let top = match kind {
+                    MarkKind::TurnEnd => (row + 1).saturating_sub(scrollbar.len),
+                    MarkKind::Input => row.saturating_sub(1),
+                };
+                max.saturating_sub(top)
+            });
+        match direction {
+            MarkDirection::Previous => offsets.filter(|&offset| offset > current).min(),
+            MarkDirection::Next => Some(
+                offsets
+                    .filter(|&offset| offset < current)
+                    .max()
+                    .unwrap_or(0),
+            ),
+        }
+    }
+}
+
+/// The first row of the agent's prompt area, counted from the top of the scrollback:
+/// Claude Code's rule above its `❯` prompt (or the top of its older prompt box), else
+/// the cursor's row.
+fn prompt_area_top(terminal: &Terminal) -> Option<usize> {
+    let total = terminal.total_rows().ok()?;
+    let active_top = total.saturating_sub(usize::from(terminal.rows().ok()?));
+    let lines = terminal
+        .screen_text_rows_range(active_top, total)
+        .ok()?
+        .iter()
+        .map(row_text)
+        .collect::<Vec<_>>();
+    let prompt = lines.iter().rposition(|line| {
+        let line = line.trim_start();
+        line.starts_with('❯') || line.starts_with("│ >")
+    });
+    let top = match prompt {
+        Some(prompt) if prompt > 0 && lines[prompt - 1].trim_start().starts_with(['─', '╭']) => {
+            prompt - 1
+        }
+        Some(prompt) => prompt,
+        None => usize::from(terminal.cursor_y().ok()?),
+    };
+    Some(active_top + top)
+}
+
+fn row_text(row: &ScreenTextRow) -> String {
+    row.cells
+        .iter()
+        .filter(|cell| !matches!(cell.wide, CellWide::SpacerTail | CellWide::SpacerHead))
+        .flat_map(|cell| {
+            let text = cell
+                .graphemes
+                .iter()
+                .filter_map(|&code| char::from_u32(code))
+                .collect::<Vec<_>>();
+            if text.is_empty() {
+                vec![' ']
+            } else {
+                text
+            }
+        })
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const COLS: u16 = 40;
+    const ROWS: u16 = 10;
+
+    fn terminal() -> Terminal {
+        Terminal::new(COLS, ROWS, 10_000_000).expect("terminal")
+    }
+
+    /// Prints `lines` of output, then a Claude-like prompt area at the bottom.
+    fn answer(terminal: &mut Terminal, label: &str, lines: usize) {
+        for line in 0..lines {
+            terminal.write(format!("{label} {line}\r\n").as_bytes());
+        }
+        prompt(terminal);
+    }
+
+    fn prompt(terminal: &mut Terminal) {
+        terminal.write("──────────\r\n❯ \r\n──────────\r\n  status".as_bytes());
+    }
+
+    /// Like Claude after a message is sent: replaces the prompt area with the message.
+    fn send(terminal: &mut Terminal, marks: &mut TurnMarks, message: &str) {
+        marks.note_typed();
+        // Back to the rule's row: cursor is on the status line, three rows below it.
+        terminal.write(b"\r\x1b[3A\x1b[J");
+        terminal.write(format!("> {message}\r\n").as_bytes());
+        marks.mark_working();
+    }
+
+    fn view_top(terminal: &Terminal) -> usize {
+        terminal.scrollbar().expect("scrollbar").offset
+    }
+
+    fn view_bottom(terminal: &Terminal) -> usize {
+        let scrollbar = terminal.scrollbar().expect("scrollbar");
+        scrollbar.offset + scrollbar.len - 1
+    }
+
+    fn row(terminal: &Terminal, y: usize) -> String {
+        row_text(&terminal.screen_text_rows_range(y, y + 1).expect("row")[0])
+            .trim_end()
+            .to_owned()
+    }
+
+    fn jump(
+        terminal: &mut Terminal,
+        marks: &mut TurnMarks,
+        kind: MarkKind,
+        direction: MarkDirection,
+    ) {
+        if let Some(offset) = marks.offset_for(terminal, kind, direction) {
+            let max = {
+                let scrollbar = terminal.scrollbar().expect("scrollbar");
+                scrollbar.total - scrollbar.len
+            };
+            if offset == 0 {
+                terminal.scroll_viewport_bottom();
+            } else {
+                terminal.scroll_viewport_row(max - offset.min(max));
+            }
+        }
+    }
+
+    /// Two finished turns and a third in progress, as a user would have them.
+    fn session(terminal: &mut Terminal, marks: &mut TurnMarks) {
+        terminal.write(b"welcome\r\n");
+        prompt(terminal);
+        marks.mark_idle(terminal, false);
+        send(terminal, marks, "first question");
+        answer(terminal, "one", 30);
+        marks.mark_idle(terminal, true);
+        send(terminal, marks, "second question");
+        answer(terminal, "two", 30);
+        marks.mark_idle(terminal, true);
+        send(terminal, marks, "third question");
+        for line in 0..30 {
+            terminal.write(format!("three {line}\r\n").as_bytes());
+        }
+    }
+
+    #[test]
+    fn previous_input_puts_each_message_at_the_top_of_the_view() {
+        let (mut terminal, mut marks) = (terminal(), TurnMarks::default());
+        session(&mut terminal, &mut marks);
+
+        jump(
+            &mut terminal,
+            &mut marks,
+            MarkKind::Input,
+            MarkDirection::Previous,
+        );
+        assert_eq!(row(&terminal, view_top(&terminal) + 1), "> third question");
+        jump(
+            &mut terminal,
+            &mut marks,
+            MarkKind::Input,
+            MarkDirection::Previous,
+        );
+        assert_eq!(row(&terminal, view_top(&terminal) + 1), "> second question");
+        jump(
+            &mut terminal,
+            &mut marks,
+            MarkKind::Input,
+            MarkDirection::Previous,
+        );
+        assert_eq!(row(&terminal, view_top(&terminal) + 1), "> first question");
+        let top = view_top(&terminal);
+        jump(
+            &mut terminal,
+            &mut marks,
+            MarkKind::Input,
+            MarkDirection::Previous,
+        );
+        assert_eq!(view_top(&terminal), top, "nothing before the first message");
+
+        jump(
+            &mut terminal,
+            &mut marks,
+            MarkKind::Input,
+            MarkDirection::Next,
+        );
+        assert_eq!(row(&terminal, view_top(&terminal) + 1), "> second question");
+    }
+
+    #[test]
+    fn previous_turn_end_puts_each_answer_end_at_the_bottom_of_the_view() {
+        let (mut terminal, mut marks) = (terminal(), TurnMarks::default());
+        session(&mut terminal, &mut marks);
+
+        jump(
+            &mut terminal,
+            &mut marks,
+            MarkKind::TurnEnd,
+            MarkDirection::Previous,
+        );
+        assert_eq!(row(&terminal, view_bottom(&terminal) - 1), "two 29");
+        assert_eq!(row(&terminal, view_bottom(&terminal)), "> third question");
+        jump(
+            &mut terminal,
+            &mut marks,
+            MarkKind::TurnEnd,
+            MarkDirection::Previous,
+        );
+        assert_eq!(row(&terminal, view_bottom(&terminal) - 1), "one 29");
+
+        jump(
+            &mut terminal,
+            &mut marks,
+            MarkKind::TurnEnd,
+            MarkDirection::Next,
+        );
+        assert_eq!(row(&terminal, view_bottom(&terminal) - 1), "two 29");
+        jump(
+            &mut terminal,
+            &mut marks,
+            MarkKind::TurnEnd,
+            MarkDirection::Next,
+        );
+        let scrollbar = terminal.scrollbar().expect("scrollbar");
+        assert_eq!(
+            scrollbar.offset + scrollbar.len,
+            scrollbar.total,
+            "back to live output"
+        );
+    }
+
+    #[test]
+    fn the_unanswered_turn_end_above_the_prompt_is_skipped() {
+        let (mut terminal, mut marks) = (terminal(), TurnMarks::default());
+        session(&mut terminal, &mut marks);
+        answer(&mut terminal, "end", 0);
+        marks.mark_idle(&mut terminal, true);
+
+        jump(
+            &mut terminal,
+            &mut marks,
+            MarkKind::TurnEnd,
+            MarkDirection::Previous,
+        );
+        assert_eq!(row(&terminal, view_bottom(&terminal) - 1), "two 29");
+    }
+
+    #[test]
+    fn going_working_without_typing_is_not_a_message() {
+        let (mut terminal, mut marks) = (terminal(), TurnMarks::default());
+        answer(&mut terminal, "one", 20);
+        marks.mark_idle(&mut terminal, true);
+        marks.mark_working();
+        answer(&mut terminal, "two", 20);
+        assert_eq!(
+            marks.offset_for(&terminal, MarkKind::Input, MarkDirection::Previous),
+            None
+        );
+    }
+
+    #[test]
+    fn marks_follow_their_rows_and_vanish_with_them() {
+        // About a page of scrollback, so old rows get pruned.
+        let mut terminal = Terminal::new(COLS, ROWS, 1_000_000).expect("terminal");
+        let mut marks = TurnMarks::default();
+        answer(&mut terminal, "one", 5);
+        marks.mark_idle(&mut terminal, true);
+        send(&mut terminal, &mut marks, "question");
+        answer(&mut terminal, "two", 20);
+        assert!(marks
+            .offset_for(&terminal, MarkKind::Input, MarkDirection::Previous)
+            .is_some());
+        // Far more output than the scrollback keeps.
+        for line in 0..50_000 {
+            terminal.write(format!("flood {line}\r\n").as_bytes());
+        }
+        assert_eq!(
+            marks.offset_for(&terminal, MarkKind::Input, MarkDirection::Previous),
+            None
+        );
+        assert!(marks.marks.is_empty());
+    }
+
+    #[test]
+    fn the_prompt_area_starts_at_the_rule_above_the_prompt() {
+        let mut terminal = terminal();
+        answer(&mut terminal, "one", 3);
+        let top = prompt_area_top(&terminal).expect("top");
+        assert_eq!(row(&terminal, top), "──────────");
+        assert_eq!(row(&terminal, top + 1), "❯");
+    }
+
+    #[test]
+    fn without_a_recognised_prompt_the_cursor_row_is_marked() {
+        let mut terminal = terminal();
+        terminal.write(b"$ ls\r\nfile\r\n$ ");
+        let top = prompt_area_top(&terminal).expect("top");
+        assert_eq!(row(&terminal, top), "$");
+    }
+}
