     }
 
+    /// Fork: keys were typed into the pane.
+    pub(crate) fn fork_note_typed(&self) {
+        self.terminal.fork_note_typed();
+    }
+
+    /// Fork: the agent went idle; `turn_end` when it had been working or waiting.
+    pub(crate) fn fork_mark_idle(&self, turn_end: bool) {
+        self.terminal.fork_mark_idle(turn_end);
+    }
+
+    /// Fork: the agent started working after being idle.
+    pub(crate) fn fork_mark_working(&self) {
+        self.terminal.fork_mark_working();
+    }
+
+    /// Fork: scroll to the previous or next turn end or message; false when none.
+    pub(crate) fn fork_scroll_to_mark(
+        &self,
+        kind: turn_marks::MarkKind,
+        direction: turn_marks::MarkDirection,
+    ) -> bool {
+        let moved = self.terminal.fork_scroll_to_mark(kind, direction);
+        if moved {
+            self.compression.wake();
+        }
+        moved
