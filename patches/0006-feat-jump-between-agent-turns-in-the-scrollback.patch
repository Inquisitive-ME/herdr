+    /// Fork: mark where an agent's turn ended and where the user's next message begins.
+    fn fork_mark_turn(&self, update: &crate::app::actions::PaneStateUpdate) {
+        use crate::detect::AgentState;
+        let Some(runtime) = self.state.runtime_for_pane_in_workspace(
+            &self.terminal_runtimes,
+            update.ws_idx,
+            update.pane_id,
+        ) else {
+            return;
+        };
+        match (update.previous_state, update.state) {
+            (previous, AgentState::Idle) if previous != AgentState::Idle => runtime.fork_mark_idle(
+                matches!(previous, AgentState::Working | AgentState::Blocked),
+            ),
+            (AgentState::Idle, AgentState::Working) => runtime.fork_mark_working(),
+            _ => {}
+        }
+    }
+
     pub(crate) fn emit_pane_state_update(&mut self, update: &crate::app::actions::PaneStateUpdate) {
+        self.fork_mark_turn(update);
         let Some(pane_id) = self.public_pane_id(update.ws_idx, update.pane_id) else {
             return;
         };
@@ -1160,6 +1180,9 @@ impl App {
