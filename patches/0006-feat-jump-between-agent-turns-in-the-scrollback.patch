index 4bf36754..ce06cca6 100644
--- a/crates/ghostty-vt/src/lib.rs
+++ b/crates/ghostty-vt/src/lib.rs
@@ -1281,6 +1281,26 @@ impl Terminal {
         (result == ffi::GhosttyResult_GHOSTTY_SUCCESS).then_some(point.y as usize)
     }
 
+    /// Fork: start tracking a row, counted from the top of the scrollback.
+    pub fn track_screen_row(&mut self, y: usize) -> Option<TrackedRow> {
+        let y = u32::try_from(y).ok()?;
+        let mut tracked = ptr::null_mut();
+        let result = unsafe {
+            ffi::ghostty_terminal_grid_ref_track(self.raw, ghostty_screen_point(0, y), &mut tracked)
+        };
+        (result == ffi::GhosttyResult_GHOSTTY_SUCCESS && !tracked.is_null())
+            .then_some(TrackedRow(tracked))
+    }
+
+    /// Fork: where a tracked row is now, counted from the top of the scrollback; None
+    /// once the terminal discarded it (pruned from the scrollback or cleared).
+    pub fn tracked_screen_row(&self, row: &TrackedRow) -> Option<usize> {
+        let mut point = ffi::GhosttyPointCoordinate::default();
+        let tag = ffi::GhosttyPointTag_GHOSTTY_POINT_TAG_SCREEN;
+        let result = unsafe { ffi::ghostty_tracked_grid_ref_point(row.0, tag, &mut point) };
+        (result == ffi::GhosttyResult_GHOSTTY_SUCCESS).then_some(point.y as usize)
+    }
+
     pub fn screen_cell(&self, x: u16, y: u32) -> Result<(CellWide, Vec<u32>), Error> {
         let grid_ref = self.grid_ref(ghostty_screen_point(x, y))?;
         let wide = grid_ref_wide(&grid_ref)?;
@@ -2303,6 +2323,20 @@ impl Drop for KittyPlacementIteratorGuard {
 // SAFETY: these opaque handles are only used behind external synchronization in pane runtime.
 unsafe impl Send for Terminal {}
 
+/// Fork: a row that moves with the terminal's content (new output, scrollback pruning,
+/// reflow) until the terminal discards it. Read it through the terminal that made it.
+pub struct TrackedRow(ffi::GhosttyTrackedGridRef);
+
+// SAFETY: the reference is only read through `Terminal::tracked_screen_row`, so callers
+// serialize it with the terminal, and libghostty allows freeing it after the terminal.
+unsafe impl Send for TrackedRow {}
+
+impl Drop for TrackedRow {
+    fn drop(&mut self) {
+        unsafe { ffi::ghostty_tracked_grid_ref_free(self.0) };
+    }
+}
+
 impl Drop for Terminal {
     fn drop(&mut self) {
         // SAFETY: freeing a null or live handle is allowed by the C API.
