+/// The shade for every other tab: the sidebar background moved slightly toward the
+/// text colour. Uses the configured sidebar colour, else the terminal's reported one.
+fn tab_band_color(
+    sidebar_bg: Color,
+    host_background: Option<crate::terminal_theme::RgbColor>,
+) -> Option<Color> {
+    let (r, g, b) = match sidebar_bg {
+        Color::Rgb(r, g, b) => (r, g, b),
+        _ => {
+            let host = host_background?;
+            (host.r, host.g, host.b)
+        }
+    };
+    let dark = u32::from(r) * 299 + u32::from(g) * 587 + u32::from(b) * 114 < 128_000;
+    let toward = if dark { 255 } else { 0 };
+    let mix = |channel: u8| {
+        let channel = i32::from(channel);
+        (channel + (toward - channel) * TAB_BAND_PERCENT / 100) as u8
+    };
+    Some(Color::Rgb(mix(r), mix(g), mix(b)))
+}
+
+/// How far the tab shade moves from the background toward the text colour.
+const TAB_BAND_PERCENT: i32 = 6;
