+    /// Shade the rows the sidebar marked (every other tab of a space, every other
+    /// waiting agent) a little lighter than the background. Only plain cells change, so
+    /// focus and selection highlights stay. Needs the real background colour: a terminal
+    /// that doesn't report it gets no shading.
+    pub(super) fn paint_shaded_rows(&self, buffer: &mut Buffer) {
+        let plain = self.config.palette.sidebar_bg;
+        let Some(shade) = tab_band_color(plain, self.host_background) else {
+            return;
+        };
+        for rect in &self.hits.shaded_rows {
+            for y in rect.y..rect.bottom() {
+                for x in rect.x..rect.right() {
+                    if let Some(cell) = buffer.cell_mut((x, y)).filter(|cell| cell.bg == plain) {
+                        cell.set_bg(shade);
+                    }
+                }
+            }
+        }
+    }
