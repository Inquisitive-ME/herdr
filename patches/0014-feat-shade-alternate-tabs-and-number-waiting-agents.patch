+#[test]
+fn alternate_tabs_are_shaded_and_waiting_agents_numbered_like_the_tree() {
+    let mut config = Config::default();
+    config.keys.focus_agent = crate::config::BindingConfig::one("ctrl+alt+1");
+    let mut snapshot = tree_snapshot();
+    snapshot.agents[0].agent_status = AgentStatus::Blocked;
+    snapshot.agents[1].agent_status = AgentStatus::Blocked;
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&config));
+    state.set_snapshot(Box::new(snapshot));
+    state.set_pane_surface(surface());
+    let plain = state.config.palette.sidebar_bg;
+    let tree_line = |state: &ClientShellState, pane_id: &str| {
+        state
+            .hits
+            .agents
+            .iter()
+            .find(|(rect, id)| id == pane_id && rect.y < state.hits.agent_body.y)
+            .map(|(rect, _)| *rect)
+            .expect("tree line")
+    };
+    let waiting = |state: &ClientShellState, pane_id: &str| {
+        state
+            .hits
+            .agents
+            .iter()
+            .find(|(rect, id)| id == pane_id && rect.y >= state.hits.agent_body.y)
+            .map(|(rect, _)| *rect)
+            .expect("waiting row")
+    };
+    let bg =
+        |frame: &FrameData, x: u16, y: u16| frame.to_ratatui_buffer().expect("buffer")[(x, y)].bg;
+
+    // Without the terminal's background colour there is nothing to shade from.
+    let frame = state.compose(106, 30).expect("frame");
+    let deploy = tree_line(&state, "pane_2");
+    assert_eq!(bg(&frame, deploy.right() - 1, deploy.y), plain);
+
+    state.host_background = Some(crate::terminal_theme::RgbColor {
+        r: 0x23,
+        g: 0x26,
+        b: 0x27,
+    });
+    let frame = state.compose(106, 30).expect("frame");
+    let shade = ratatui::style::Color::Rgb(48, 51, 51);
+    // ws_1's second tab is shaded; ws_2's first tab (a terminal) starts over.
+    let deploy = tree_line(&state, "pane_2");
+    let server = tree_line(&state, "pane_3");
+    assert_eq!(bg(&frame, deploy.right() - 1, deploy.y), shade);
+    assert_eq!(bg(&frame, server.right() - 1, server.y), plain);
+    // The terminal's prompt sits where agents show their number.
+    assert_eq!(cell(&frame, deploy.x + 1, deploy.y), "2");
+    assert_eq!(cell(&frame, server.x + 1, server.y), "$");
+
+    // Waiting agents carry their tree number in the same column; one of the two is shaded.
+    let first = waiting(&state, "pane_1");
+    let second = waiting(&state, "pane_2");
+    assert_eq!(cell(&frame, first.x + 2, first.y), "1");
+    assert_eq!(cell(&frame, second.x + 2, second.y), "2");
+    assert_eq!(first.x + 2, deploy.x + 1);
+    let shaded = [first, second]
+        .iter()
+        .filter(|rect| bg(&frame, rect.right() - 1, rect.y) == shade)
+        .count();
+    assert_eq!(shaded, 1);
+}
