From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Richard Swanson <rswanson05@gmail.com>
Date: Sat, 7 Nov 2026 21:37:27 -0600
Subject: [PATCH] chore: read stable updates from inquisitive-me/herdr releases

herdr update, background version checks and remote installs use this
fork's latest.json, so the patched build is not replaced by upstream.

diff --git a/src/remote/attach.rs b/src/remote/attach.rs
index 5d2dc3b6..2a523f82 100644
--- a/src/remote/attach.rs
+++ b/src/remote/attach.rs
@@ -30,7 +30,9 @@ const NONINTERACTIVE_SSH_STDERR_LIMIT: usize = 16 * 1024;
 const BRIDGE_FAILURE_REPORT_TIMEOUT: Duration = Duration::from_secs(1);
 const REMOTE_SERVER_SHUTDOWN_POLL_INTERVAL: Duration = Duration::from_millis(100);
 const CURRENT_PROTOCOL: u32 = crate::protocol::PROTOCOL_VERSION;
-const STABLE_UPDATE_MANIFEST_URL: &str = "https://herdr.dev/latest.json";
+// Fork: updates come from Inquisitive-ME/herdr releases (upstream herdr plus sidebar patches).
+const STABLE_UPDATE_MANIFEST_URL: &str =
+    "https://github.com/Inquisitive-ME/herdr/releases/latest/download/latest.json";
 const PREVIEW_UPDATE_MANIFEST_URL: &str = "https://herdr.dev/preview.json";
 const REMOTE_BINARY_ENV_VAR: &str = "HERDR_REMOTE_BINARY";
 const REMOTE_OUTPUT_READY_MARKER: &str = "herdr-remote-output-ready:1";
diff --git a/src/update.rs b/src/update.rs
index 854bacdc..17ddf80c 100644
--- a/src/update.rs
+++ b/src/update.rs
@@ -22,7 +22,9 @@ use std::time::{Duration, Instant};
 use interprocess::local_socket::traits::Stream as _;
 use serde::{Deserialize, Deserializer};
 
-const STABLE_UPDATE_MANIFEST_URL: &str = "https://herdr.dev/latest.json";
+// Fork: updates come from Inquisitive-ME/herdr releases (upstream herdr plus sidebar patches).
+const STABLE_UPDATE_MANIFEST_URL: &str =
+    "https://github.com/Inquisitive-ME/herdr/releases/latest/download/latest.json";
 const PREVIEW_UPDATE_MANIFEST_URL: &str = "https://herdr.dev/preview.json";
 const HOMEBREW_FORMULA_API_URL: &str = "https://formulae.brew.sh/api/formula/herdr.json";
 const HERDR_UPDATE_COMMAND: &str = "herdr update";
