+/// Fork: a new patch release of the same upstream version. Builds without a release
+/// tag (local builds) never chase one.
+fn fork_rebuild_available(
+    latest: &Version,
+    current: &Version,
+    latest_release: Option<&str>,
+    installed_release: Option<&str>,
+) -> bool {
+    latest == current
+        && installed_release
+            .zip(latest_release)
+            .is_some_and(|(installed, latest)| installed != latest)
+}
