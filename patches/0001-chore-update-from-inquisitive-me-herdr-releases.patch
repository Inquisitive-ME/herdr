+    /// Fork: a new patch release of the installed upstream version is an update.
+    #[test]
+    fn fork_rebuild_of_the_same_version_is_an_update() {
+        let v = |text| Version::parse(text).unwrap();
+        let tree = |hash: &'static str| Some(hash);
+        assert!(fork_rebuild_available(
+            &v("0.9.5"),
+            &v("0.9.5"),
+            tree("v0.9.5-tree.b"),
+            tree("v0.9.5-tree.a")
+        ));
+        assert!(!fork_rebuild_available(
+            &v("0.9.5"),
+            &v("0.9.5"),
+            tree("v0.9.5-tree.a"),
+            tree("v0.9.5-tree.a")
+        ));
+        // Local builds have no release tag and never chase one; nor do old manifests.
+        assert!(!fork_rebuild_available(
+            &v("0.9.5"),
+            &v("0.9.5"),
+            tree("v0.9.5-tree.b"),
+            None
+        ));
+        assert!(!fork_rebuild_available(
+            &v("0.9.5"),
+            &v("0.9.5"),
+            None,
+            tree("v0.9.5-tree.a")
+        ));
+        // Other versions are left to the normal version comparison.
+        assert!(!fork_rebuild_available(
+            &v("0.9.4"),
+            &v("0.9.5"),
+            tree("v0.9.4-tree.b"),
+            tree("v0.9.5-tree.a")
+        ));
+    }
+
