+/// `dir` relative to the space's `home`, or a home-shortened path outside it.
+fn place_text(dir: &str, home: &str) -> Option<String> {
+    let dir = dir.trim_end_matches('/');
+    let home = home.trim_end_matches('/');
+    if dir == home || dir.is_empty() {
+        return None;
+    }
+    if let Some(inside) = dir
+        .strip_prefix(home)
+        .and_then(|rest| rest.strip_prefix('/'))
+    {
+        return Some(inside.to_owned());
+    }
+    for users in ["/home/", "/Users/"] {
+        if let Some(rest) = dir.strip_prefix(users) {
+            return Some(match rest.split_once('/') {
+                Some((_, below)) => format!("~/{below}"),
+                None => "~".to_owned(),
+            });
+        }
+    }
+    Some(dir.to_owned())
+}
