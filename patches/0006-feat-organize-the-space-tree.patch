+/// Build the tree for one space: each tab's panes, agents first-class and plain
+/// terminals dimmed (unless hidden for this space).
+pub(in crate::client::shell) fn space_tree<'a>(
     snapshot: &'a ClientShellSnapshot,
-    workspace_id: &str,
-) -> Vec<&'a ClientShellAgent> {
-    snapshot
+    workspace_id: &'a str,
+    collapsed_groups: &HashSet<String>,
+) -> SpaceTree<'a> {
+    let show_terminals = !collapsed_groups.contains(&terminals_hidden_key(workspace_id));
+    let tabs = snapshot
+        .tabs
+        .iter()
+        .filter(|tab| tab.workspace_id == workspace_id)
+        .collect::<Vec<_>>();
+    let panes = snapshot
+        .panes
+        .iter()
+        .filter(|pane| pane.workspace_id == workspace_id)
+        .collect::<Vec<_>>();
+    // The space's home is where its first tab works.
+    let home = tabs
+        .iter()
+        .find_map(|tab| panes.iter().find(|pane| pane.tab_id == tab.tab_id))
+        .and_then(|pane| pane_dir(pane));
+    let mut items = Vec::new();
+    for tab in &tabs {
+        let tab_panes = panes
+            .iter()
+            .filter(|pane| pane.tab_id == tab.tab_id)
+            .collect::<Vec<_>>();
+        for pane in &tab_panes {
+            let agent = snapshot
+                .agents
+                .iter()
+                .find(|agent| agent.pane_id == pane.pane_id);
+            let (kind, label, named_by_dir) = match agent {
+                Some(agent) => (
+                    SpaceItemKind::Agent(agent),
+                    agent_label(snapshot, agent).to_owned(),
+                    false,
+                ),
+                None if show_terminals => {
+                    let (label, named_by_dir) = terminal_label(tab, pane);
+                    (SpaceItemKind::Terminal, label, named_by_dir)
+                }
+                None => continue,
+            };
+            let place = (!named_by_dir)
+                .then(|| {
+                    pane_dir(pane)
+                        .zip(home)
+                        .and_then(|(dir, home)| place_text(dir, home))
+                })
+                .flatten();
+            items.push(SpaceItem {
+                pane_id: &pane.pane_id,
+                kind,
+                label,
+                focused: pane.focused,
+                place,
+            });
+        }
+    }
+    // Never hide an agent the pane list doesn't cover.
+    let unlisted = snapshot
         .agents
         .iter()
-        .filter(|agent| agent.workspace_id == workspace_id)
-        .collect()
+        .filter(|agent| {
+            agent.workspace_id == workspace_id
+                && !items.iter().any(|item| item.pane_id == agent.pane_id)
+        })
+        .collect::<Vec<_>>();
+    for agent in unlisted {
+        items.push(SpaceItem {
+            pane_id: &agent.pane_id,
+            kind: SpaceItemKind::Agent(agent),
+            label: agent_label(snapshot, agent).to_owned(),
+            focused: agent.focused,
+            place: None,
+        });
+    }
+    SpaceTree {
+        workspace_id,
+        collapsed: !items.is_empty() && collapsed_groups.contains(&collapsed_key(workspace_id)),
+        items,
+    }
 }
 
