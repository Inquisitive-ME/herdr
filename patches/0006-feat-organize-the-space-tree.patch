+//! Fork: mouse behavior of the space tree in the expanded sidebar.
+
+use super::*;
+use crate::api::schema::{Method, PaneMoveDestination};
+
+fn tree_snapshot() -> ClientShellSnapshot {
+    let mut snapshot = snapshot();
+    let mut second = snapshot.workspaces[0].clone();
+    second.workspace_id = "ws_2".into();
+    second.label = "personal".into();
+    second.focused = false;
+    snapshot.workspaces.push(second);
+    let mut tab_2 = snapshot.tabs[0].clone();
+    tab_2.tab_id = "tab_2".into();
+    tab_2.label = "deploy".into();
+    tab_2.custom_label = true;
+    tab_2.focused = false;
+    let mut tab_3 = tab_2.clone();
+    tab_3.tab_id = "tab_3".into();
+    tab_3.workspace_id = "ws_2".into();
+    tab_3.label = "server".into();
+    snapshot.tabs.extend([tab_2, tab_3]);
+    let mut pane_2 = snapshot.panes[0].clone();
+    pane_2.pane_id = "pane_2".into();
+    pane_2.tab_id = "tab_2".into();
+    pane_2.focused = false;
+    let mut pane_3 = pane_2.clone();
+    pane_3.pane_id = "pane_3".into();
+    pane_3.tab_id = "tab_3".into();
+    pane_3.workspace_id = "ws_2".into();
+    snapshot.panes.extend([pane_2, pane_3]);
+    let agent = |pane_id: &str, tab_id: &str, status| ClientShellAgent {
+        pane_id: pane_id.into(),
+        workspace_id: "ws_1".into(),
+        tab_id: tab_id.into(),
+        name: None,
+        display_agent: None,
+        agent: Some("claude".into()),
+        title: None,
+        terminal_title: None,
+        terminal_title_stripped: None,
+        agent_status: status,
+        state_change_seq: 0,
+        state_labels: Vec::new(),
+        tokens: Vec::new(),
+        focused: pane_id == "pane_1",
+    };
+    snapshot.agents = vec![
+        agent("pane_1", "tab_1", AgentStatus::Done),
+        agent("pane_2", "tab_2", AgentStatus::Working),
+    ];
+    snapshot
+}
+
+fn tree_state() -> ClientShellState {
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(Box::new(tree_snapshot()));
+    state.set_pane_surface(surface());
+    state.compose(106, 30).expect("frame");
+    state
+}
+
+fn mouse(state: &mut ClientShellState, kind: MouseEventKind, at: Rect) -> ClientShellInput {
+    state.handle_raw_events(vec![RawInputEvent::Mouse(MouseEvent {
+        kind,
+        column: at.x + 4,
+        row: at.y,
+        modifiers: KeyModifiers::empty(),
+    })])
+}
+
+fn line(state: &ClientShellState, pane_id: &str) -> Rect {
+    state
+        .hits
+        .agents
+        .iter()
+        .find(|(_, id)| id == pane_id)
+        .map(|(rect, _)| *rect)
+        .expect("tree line")
+}
+
+fn space(state: &ClientShellState, workspace_id: &str) -> Rect {
+    state
+        .hits
+        .workspaces
+        .iter()
+        .find(|hit| hit.workspace_id == workspace_id)
+        .map(|hit| hit.rect)
+        .expect("space rows")
+}
+
+fn methods(input: &ClientShellInput) -> Vec<&Method> {
+    input
+        .actions
+        .iter()
+        .filter_map(|action| match action {
+            ClientShellAction::Endpoint { request, .. } => Some(&request.method),
+            _ => None,
+        })
+        .collect()
+}
+
+#[test]
+fn terminals_are_listed_under_their_space() {
+    let state = tree_state();
+    line(&state, "pane_1");
+    line(&state, "pane_2");
+    line(&state, "pane_3");
+}
+
+#[test]
+fn clicking_a_line_focuses_its_pane_on_release() {
+    let mut state = tree_state();
+    let target = line(&state, "pane_2");
+    let down = mouse(&mut state, MouseEventKind::Down(MouseButton::Left), target);
+    assert!(methods(&down).is_empty());
+    let up = mouse(&mut state, MouseEventKind::Up(MouseButton::Left), target);
+    assert!(matches!(
+        methods(&up)[..],
+        [Method::PaneFocus(target)] if target.pane_id == "pane_2"
+    ));
+}
+
+#[test]
+fn dragging_a_line_onto_another_space_moves_its_pane_there() {
+    let mut state = tree_state();
+    let source = line(&state, "pane_2");
+    let destination = space(&state, "ws_2");
+    mouse(&mut state, MouseEventKind::Down(MouseButton::Left), source);
+    let drag = mouse(
+        &mut state,
+        MouseEventKind::Drag(MouseButton::Left),
+        destination,
+    );
+    assert!(drag.repaint);
+    state.compose(106, 30).expect("frame while dragging");
+    let up = mouse(
+        &mut state,
+        MouseEventKind::Up(MouseButton::Left),
+        destination,
+    );
+    assert!(matches!(
+        methods(&up)[..],
+        [Method::PaneMove(params)] if params.pane_id == "pane_2"
+            && params.destination == PaneMoveDestination::NewTab {
+                workspace_id: Some("ws_2".into()),
+                label: Some("deploy".into()),
+            }
+    ));
+}
+
+#[test]
+fn dragging_a_line_within_its_space_reorders_tabs() {
+    let mut state = tree_state();
+    let source = line(&state, "pane_2");
+    let target = line(&state, "pane_1");
+    mouse(&mut state, MouseEventKind::Down(MouseButton::Left), source);
+    mouse(&mut state, MouseEventKind::Drag(MouseButton::Left), target);
+    let up = mouse(&mut state, MouseEventKind::Up(MouseButton::Left), target);
+    assert!(matches!(
+        methods(&up)[..],
+        [Method::TabMove(params)] if params.tab_id == "tab_2" && params.insert_index == 0
+    ));
+}
+
+#[test]
+fn space_toggle_collapses_and_the_summary_expands() {
+    let mut state = tree_state();
+    let toggle = state
+        .hits
+        .space_toggles
+        .iter()
+        .find(|(_, _, key)| key.ends_with("ws_1"))
+        .map(|(rect, _, _)| *rect)
+        .expect("toggle on the space row");
+    state.handle_raw_events(vec![RawInputEvent::Mouse(MouseEvent {
+        kind: MouseEventKind::Down(MouseButton::Left),
+        column: toggle.x,
+        row: toggle.y,
+        modifiers: KeyModifiers::empty(),
+    })]);
+    state.compose(106, 30).expect("collapsed frame");
+    assert!(!state.hits.agents.iter().any(|(_, id)| id == "pane_1"));
+    let summary = state
+        .hits
+        .space_toggles
+        .iter()
+        .find(|(rect, _, key)| key.ends_with("ws_1") && rect.width > 1)
+        .map(|(rect, _, _)| *rect)
+        .expect("summary row");
+    mouse(&mut state, MouseEventKind::Down(MouseButton::Left), summary);
+    state.compose(106, 30).expect("expanded frame");
+    line(&state, "pane_1");
+}
