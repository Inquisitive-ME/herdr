+/// One row standing in for a collapsed tree: a count per agent status, then terminals.
+fn render_summary(
+    buffer: &mut Buffer,
+    line: Rect,
+    indent: u16,
+    tree: &SpaceTree<'_>,
+    config: &ClientShellConfig,
+) {
+    let palette = &config.palette;
+    let mut spans = Vec::new();
+    for status in [
+        AgentStatus::Blocked,
+        AgentStatus::Working,
+        AgentStatus::Done,
+        AgentStatus::Idle,
+        AgentStatus::Unknown,
+    ] {
+        let count = tree
+            .items
+            .iter()
+            .filter(|item| {
+                item.agent()
+                    .is_some_and(|agent| agent.agent_status == status)
+            })
+            .count();
+        if count > 0 {
+            spans.push(Span::styled(
+                format!("{}{count} ", status_icon(status, config.status_indicators)),
+                Style::default().fg(status_color(status, palette)),
+            ));
+        }
+    }
+    let terminals = tree
+        .items
+        .iter()
+        .filter(|item| item.agent().is_none())
+        .count();
+    if terminals > 0 {
+        spans.push(Span::styled(
+            format!("›{terminals}"),
+            Style::default().fg(palette.overlay0),
+        ));
+    }
+    let x = line.x.saturating_add(indent).min(line.right());
+    Paragraph::new(Line::from(spans)).render(
+        Rect::new(x, line.y, line.right().saturating_sub(x), 1),
+        buffer,
+    );
+}
