+#[test]
+fn right_clicking_a_line_offers_moves_to_other_spaces() {
+    let mut state = tree_state();
+    let target = line(&state, "pane_2");
+    mouse(&mut state, MouseEventKind::Down(MouseButton::Right), target);
+    let Some(ClientShellOverlay::ContextMenu(menu)) = state.overlay.as_ref() else {
+        panic!("context menu");
+    };
+    let labels = menu
+        .items()
+        .iter()
+        .map(|item| item.label.to_string())
+        .collect::<Vec<_>>();
+    assert_eq!(
+        labels,
+        [
+            "Rename tab",
+            "Move to personal",
+            "Move to new space",
+            "Close"
+        ]
+    );
+}
