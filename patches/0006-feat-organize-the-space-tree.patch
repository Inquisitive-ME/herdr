+#[test]
+fn agent_lines_show_how_long_they_have_been_in_their_state() {
+    let mut snapshot = tree_snapshot();
+    let since = crate::client::shell::space_agents::now_unix_ms() - 12 * 60_000 - 5_000;
+    snapshot.agents[1].tokens = vec![(
+        crate::metadata_tokens::STATE_SINCE_TOKEN.to_owned(),
+        since.to_string(),
+    )];
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(Box::new(snapshot));
+    state.set_pane_surface(surface());
+    let frame = state.compose(106, 30).expect("frame");
+    let deploy = line(&state, "pane_2");
+    let row = frame_rows(&frame)[deploy.y as usize]
+        .chars()
+        .take(deploy.right() as usize)
+        .collect::<String>();
+    assert!(row.trim_end().ends_with("12m"), "{row}");
+}
