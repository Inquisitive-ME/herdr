 pub(in crate::client::shell) fn agent_cycle(snapshot: &ClientShellSnapshot) -> Vec<String> {
     let all = tree_agent_pane_ids(snapshot);
-    let waiting = all
-        .iter()
-        .filter(|pane_id| {
-            snapshot
-                .agents
-                .iter()
-                .any(|agent| agent.pane_id == **pane_id && needs_input(agent.agent_status))
-        })
-        .cloned()
-        .collect::<Vec<_>>();
-    if waiting.is_empty() {
-        all
-    } else {
-        waiting
+    for attention in [Attention::NeedsInput, Attention::Finished] {
+        let group = all
+            .iter()
+            .filter(|pane_id| {
+                snapshot.agents.iter().any(|agent| {
+                    agent.pane_id == **pane_id
+                        && Attention::of(agent.agent_status) == Some(attention)
+                })
+            })
+            .cloned()
+            .collect::<Vec<_>>();
+        if !group.is_empty() {
+            return group;
+        }
     }
+    all
 }
 
