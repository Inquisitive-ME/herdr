+/// How urgently an agent wants the user, most urgent first.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
+pub(in crate::client::shell) enum Attention {
+    /// Blocked on a prompt: a permission, a question or a plan approval.
+    NeedsInput,
+    /// Finished a turn the user hasn't looked at yet.
+    Finished,
+}
+
+impl Attention {
+    pub(in crate::client::shell) fn of(status: AgentStatus) -> Option<Self> {
+        match status {
+            AgentStatus::Blocked => Some(Self::NeedsInput),
+            AgentStatus::Done => Some(Self::Finished),
+            AgentStatus::Working | AgentStatus::Idle | AgentStatus::Unknown => None,
+        }
+    }
+
+    fn title(self) -> &'static str {
+        match self {
+            Self::NeedsInput => " needs input",
+            Self::Finished => " finished",
+        }
+    }
+}
+
+/// One entry of the attention section: a group heading or an agent row.
+pub(in crate::client::shell) enum AttentionEntry<T> {
+    /// A blank line, then the group's name.
+    Heading(Attention),
+    Agent(T),
+}
+
+impl<T> AttentionEntry<T> {
+    pub(in crate::client::shell) fn lines(&self, agent_lines: impl Fn(&T) -> usize) -> usize {
+        match self {
+            Self::Heading(_) => 2,
+            Self::Agent(row) => agent_lines(row),
+        }
+    }
+}
+
+/// Group the agents waiting on the user, most urgent group first, keeping their order
+/// within a group. The first group names the section; later groups get a heading.
+pub(in crate::client::shell) fn attention_entries<T>(
+    rows: Vec<T>,
+    status: impl Fn(&T) -> AgentStatus,
+) -> (&'static str, Vec<AttentionEntry<T>>) {
+    let mut grouped = rows
+        .into_iter()
+        .filter_map(|row| Attention::of(status(&row)).map(|attention| (attention, row)))
+        .collect::<Vec<_>>();
+    grouped.sort_by_key(|(attention, _)| *attention);
+    let title = grouped
+        .first()
+        .map_or(Attention::NeedsInput.title(), |(attention, _)| {
+            attention.title()
+        });
+    let mut entries = Vec::with_capacity(grouped.len() + 1);
+    let mut previous = None;
+    for (attention, row) in grouped {
+        if previous.is_some_and(|previous| previous != attention) {
+            entries.push(AttentionEntry::Heading(attention));
+        }
+        previous = Some(attention);
+        entries.push(AttentionEntry::Agent(row));
+    }
+    (title, entries)
+}
+
+/// Draw a group heading on the second line of its two-line entry.
+pub(in crate::client::shell) fn render_attention_heading(
+    buffer: &mut Buffer,
+    rect: Rect,
+    attention: Attention,
+    config: &ClientShellConfig,
+) {
+    if rect.height < 2 {
+        return;
+    }
+    put_text(
+        buffer,
+        rect.x,
+        rect.y + 1,
+        rect.width,
+        attention.title(),
+        Style::default()
+            .fg(config.palette.overlay0)
+            .add_modifier(Modifier::BOLD),
+    );
+}
+
+/// Height of the attention section's list for these rows.
+pub(in crate::client::shell) fn attention_list_height<T>(
+    rows: Vec<T>,
+    status: impl Fn(&T) -> AgentStatus,
+    agent_lines: impl Fn(&T) -> usize,
+    row_gap: u16,
+) -> u16 {
+    let (_, entries) = attention_entries(rows, status);
+    list_height(
+        entries
+            .iter()
+            .map(|entry| entry.lines(&agent_lines).min(u16::MAX as usize) as u16),
+        row_gap,
+    )
 }
 
