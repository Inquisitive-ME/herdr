+#[test]
+fn fork_machine_enable_and_disable_accept_a_label() {
+    let harness = Harness::new();
+    for (action, enabled) in [("disable", false), ("enable", true)] {
+        let output = harness
+            .command(&["machine", action, "mac"])
+            .output()
+            .unwrap();
+        assert!(
+            output.status.success(),
+            "{}",
+            String::from_utf8_lossy(&output.stderr)
+        );
+        let catalog: Value =
+            serde_json::from_slice(&fs::read(harness.state.join("endpoints.json")).unwrap())
+                .unwrap();
+        assert_eq!(catalog["ssh"][0]["enabled"], enabled);
+    }
+    harness.assert_local_untouched();
+}
+
