 fn profile_command(name: &'static str, about: &'static str) -> Command {
diff --git a/src/cli/target.rs b/src/cli/target.rs
index 9c8b9c80..b2217c48 100644
--- a/src/cli/target.rs
+++ b/src/cli/target.rs
@@ -261,25 +261,32 @@ pub(super) fn resolve_machine<'a>(
     profiles: &'a [SavedSshEndpoint],
     selector: &str,
 ) -> Result<&'a SavedSshEndpoint, String> {
-    let profile = if let Some(profile) = profiles
