index 00000000..10aa55a1
--- /dev/null
+++ b/src/client/shell/turn_marks.rs
@@ -0,0 +1,472 @@
+//! Fork: marks on a pane's scrollbar where the user's messages to its agent began and,
+//! for Claude Code, where its replies did. Hovering a mark shows what is there; clicking
+//! one outside the thumb scrolls it to one row below the top of the view, like
+//! `previous_input`.
+//!
+//! The server lists the messages (`pane.mark.list`). A pane's list is fetched again when
+//! its agent changes state, when the pane is rewrapped, and when the scrollback of an
+//! agent that isn't working changes length (a resumed session printing its history).
+//!
+//! Lives in its own file so upstream changes rarely conflict with it.
+
+use std::time::{Duration, Instant};
+
+use ratatui::{
+    text::{Line, Span},
+    widgets::{Block, BorderType, Clear, Paragraph, Widget},
+};
+
+use super::*;
+use crate::api::schema::{AgentStatus, PaneListedMarkKind};
+use crate::pane::ScrollMetrics;
+use crossterm::event::MouseEvent;
+
+/// Drawn in the scrollbar's column, on the row the thumb's top moves to when the view
+/// shows the message or the reply. A message's mark covers a reply's on the same row.
+pub(super) const MESSAGE_GLYPH: &str = "◂";
+pub(super) const REPLY_GLYPH: &str = "◃";
+
+/// Stands where a message's number would in a card's line for a reply.
+const REPLY_LABEL: &str = "●";
+
+/// The most lines a card lists, and the widest their text is drawn.
+const CARD_ROWS: usize = 5;
+const CARD_TEXT_WIDTH: usize = 60;
+
+/// The least time between two lists asked only because the scrollback changed length.
+const RELIST_INTERVAL: Duration = Duration::from_secs(1);
+
+/// What a pane's list was asked for.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) struct TurnMarksAsk {
+    state_change_seq: u64,
+    width: u16,
+    /// The pane's largest scroll offset, which follows the length of its scrollback.
+    extent: usize,
+    at: Instant,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+struct ListedMark {
+    reply: bool,
+    /// Its first row, counted from the top of the scrollback.
+    row: usize,
+    text: String,
+}
+
+struct PaneTurnMarks {
+    asked: TurnMarksAsk,
+    marks: Vec<ListedMark>,
+}
+
+/// Where a pane's marks were last drawn. Clicks, hovering and patches go by this, so they
+/// agree with what is on the screen until the next full frame.
+pub(super) struct DrawnMarks {
+    track: Rect,
+    metrics: ScrollMetrics,
+    /// For each of the track's rows: nothing, a reply's mark (false) or a message's (true).
+    rows: Vec<Option<bool>>,
+}
+
+#[derive(Default)]
+pub(super) struct TurnMarksState {
+    /// The server the lists came from: another server's panes may use the same ids.
+    boot_id: String,
+    panes: HashMap<String, PaneTurnMarks>,
+    /// Set as a frame is composed, from `turn_marks_to_draw`.
+    pub(super) drawn: HashMap<String, DrawnMarks>,
+    /// Where the mouse was last seen.
+    hover: Option<(u16, u16)>,
+}
+
+/// The scroll offset that shows the row `row` one row below the top of the view, as the
+/// jump keys do.
+fn mark_offset(row: usize, metrics: ScrollMetrics) -> usize {
+    metrics
+        .max_offset_from_bottom
+        .saturating_sub(row.saturating_sub(1))
+}
+
+/// The scrollbar row of the mark for the scrollback row `row`.
+fn mark_track_row(row: usize, metrics: ScrollMetrics, track: Rect) -> Option<u16> {
+    let shown = ScrollMetrics {
+        offset_from_bottom: mark_offset(row, metrics),
+        ..metrics
+    };
+    crate::ui::scrollbar_thumb(shown, track).map(|thumb| thumb.top)
+}
+
+/// What to draw on each row of `track`.
+fn track_rows(marks: &[ListedMark], metrics: ScrollMetrics, track: Rect) -> Vec<Option<bool>> {
+    let mut rows = vec![None; usize::from(track.height)];
+    for mark in marks {
+        let Some(row) = mark_track_row(mark.row, metrics, track) else {
+            continue;
+        };
+        if let Some(drawn) = rows.get_mut(usize::from(row.saturating_sub(track.y))) {
+            *drawn = Some(*drawn == Some(true) || !mark.reply);
+        }
+    }
+    rows
+}
+
+impl ClientShellState {
+    /// Ask for the messages of each shown agent pane whose list is out of date, and
+    /// repaint when marks are no longer where they were drawn.
+    pub(crate) fn tick_turn_marks(&mut self, now: Instant, outcome: &mut ClientShellInput) {
+        let Some(snapshot) = self.snapshot.as_deref() else {
+            return;
+        };
+        if self.turn_marks.boot_id != snapshot.boot_id {
+            self.turn_marks.boot_id.clone_from(&snapshot.boot_id);
+            self.turn_marks.panes.clear();
+        }
+        self.turn_marks.panes.retain(|pane_id, _| {
+            snapshot
+                .agents
+                .iter()
+                .any(|agent| agent.pane_id == *pane_id)
+        });
+        outcome.repaint |= self.hits.panes.iter().any(|hit| {
+            let (Some(pane), Some(drawn), Some(track), Some(metrics)) = (
+                self.turn_marks.panes.get(&hit.pane_id),
+                self.turn_marks.drawn.get(&hit.pane_id),
+                hit.scrollbar_rect,
+                hit.scroll,
+            ) else {
+                return false;
+            };
+            metrics != drawn.metrics && track_rows(&pane.marks, metrics, track) != drawn.rows
+        });
+        // The marks are optional: no probing of servers that don't list the method, and
+        // no notices about them.
+        if !self.endpoint_is_online(&self.active_endpoint_id)
+            || !self
+                .endpoints
+                .iter()
+                .find(|endpoint| endpoint.endpoint_id == self.active_endpoint_id)
+                .and_then(|endpoint| endpoint.methods.as_ref())
+                .is_some_and(|methods| methods.iter().any(|method| method == "pane.mark.list"))
+        {
+            return;
+        }
+        let stale = self
+            .hits
+            .panes
+            .iter()
+            .filter(|hit| !hit.popup && hit.scrollbar_rect.is_some())
+            .filter_map(|hit| {
+                let agent = snapshot
+                    .agents
+                    .iter()
+                    .find(|agent| agent.pane_id == hit.pane_id)?;
+                let ask = TurnMarksAsk {
+                    state_change_seq: agent.state_change_seq,
+                    width: hit.inner_rect.width,
+                    extent: hit.scroll.map_or(0, |scroll| scroll.max_offset_from_bottom),
+                    at: now,
+                };
+                let stale = self.turn_marks.panes.get(&hit.pane_id).is_none_or(|pane| {
+                    let asked = pane.asked;
+                    (asked.state_change_seq, asked.width) != (ask.state_change_seq, ask.width)
+                            // A working agent's output only adds to what is listed once
+                            // its turn ends, which changes its state.
+                            || (agent.agent_status != AgentStatus::Working
+                                && asked.extent != ask.extent
+                                && now.saturating_duration_since(asked.at) >= RELIST_INTERVAL)
+                });
+                stale.then(|| (hit.pane_id.clone(), ask))
+            })
+            .filter(|(pane_id, _)| {
+                !self.pending_requests.values().any(|pending| {
+                    matches!(
+                        &pending.kind,
+                        PendingEndpointKind::PaneMarkList { pane_id: asked, .. } if asked == pane_id
+                    )
+                })
+            })
+            .collect::<Vec<_>>();
+        for (pane_id, asked) in stale {
+            self.push_endpoint_method_with_kind(
+                crate::api::schema::Method::PaneMarkList(crate::api::schema::PaneTarget {
+                    pane_id: pane_id.clone(),
+                }),
+                PendingEndpointKind::PaneMarkList { pane_id, asked },
+                outcome,
+            );
+        }
+    }
+
+    /// Keep what the server listed for a pane; a failed request lists nothing until the
+    /// pane is asked about again. Returns whether the marks changed.
+    pub(super) fn complete_turn_marks(
+        &mut self,
+        pane_id: String,
+        asked: TurnMarksAsk,
+        result: Result<crate::api::schema::ResponseResult, ClientShellEndpointError>,
+    ) -> bool {
+        let marks = match result {
+            Ok(crate::api::schema::ResponseResult::PaneMarkList { marks }) => marks
+                .into_iter()
+                .map(|mark| ListedMark {
+                    reply: mark.kind == PaneListedMarkKind::Reply,
+                    row: usize::try_from(mark.row).unwrap_or(usize::MAX),
+                    text: mark.text,
+                })
+                .collect(),
+            _ => Vec::new(),
+        };
+        let changed = self
+            .turn_marks
+            .panes
+            .get(&pane_id)
+            .map_or(!marks.is_empty(), |pane| pane.marks != marks);
+        self.turn_marks
+            .panes
+            .insert(pane_id, PaneTurnMarks { asked, marks });
+        changed
+    }
+
+    /// The pane's listed marks drawn on the screen row `row` of its scrollbar, oldest
+    /// first, each with its place in the list.
+    fn turn_marks_on_row<'a>(
+        &'a self,
+        hit: &PaneHit,
+        row: u16,
+    ) -> impl Iterator<Item = (usize, &'a ListedMark)> {
+        let marks = self.turn_marks.panes.get(&hit.pane_id);
+        let drawn = self.turn_marks.drawn.get(&hit.pane_id);
+        marks.zip(drawn).into_iter().flat_map(move |(pane, drawn)| {
+            pane.marks.iter().enumerate().filter(move |(_, mark)| {
+                mark_track_row(mark.row, drawn.metrics, drawn.track) == Some(row)
+            })
+        })
+    }
+
+    /// The scroll offset for a click on scrollbar row `row`, when a mark is drawn there:
+    /// the offset showing the oldest message or reply marked on that row.
+    pub(super) fn turn_mark_offset(&self, hit: &PaneHit, row: u16) -> Option<usize> {
+        let metrics = hit.scroll?;
+        self.turn_marks_on_row(hit, row)
+            .next()
+            .map(|(_, mark)| mark_offset(mark.row, metrics))
+    }
+
+    /// The mark under the mouse: its pane's place in the hit list and its scrollbar row.
+    /// None while something else owns the mouse or covers the panes.
+    fn hovered_turn_mark(&self) -> Option<(usize, u16)> {
+        let point = self.turn_marks.hover?;
+        if self.overlay.is_some()
+            || self.popup_terminal_id.is_some()
+            || self.chrome_drag.is_some()
+            || self.pane_mouse_gesture.is_some()
+        {
+            return None;
+        }
+        let (index, hit) = self.hits.panes.iter().enumerate().find(|(_, hit)| {
+            !hit.popup
+                && hit
+                    .scrollbar_rect
+                    .is_some_and(|track| super::contains(track, point))
+        })?;
+        self.turn_marks_on_row(hit, point.1).next()?;
+        Some((index, point.1))
+    }
+
+    pub(super) fn update_turn_mark_hover(
+        &mut self,
+        mouse: MouseEvent,
+        outcome: &mut ClientShellInput,
+    ) {
+        let before = self.hovered_turn_mark();
+        self.turn_marks.hover = Some((mouse.column, mouse.row));
+        outcome.repaint |= self.hovered_turn_mark() != before;
+    }
+
+    /// A pane surface patch can't be applied in place under a mark's card.
+    pub(super) fn turn_marks_block_patch(&self) -> bool {
+        self.hovered_turn_mark().is_some()
+    }
+
+    /// Put the marks back on the scrollbar cells a patch applied in place redraws.
+    pub(super) fn turn_marks_over_patch(
+        &self,
+        mut patch: ClientComposedSurfacePatch,
+    ) -> ClientComposedSurfacePatch {
+        if self.turn_marks.drawn.is_empty() {
+            return patch;
+        }
+        let palette = &self.config.palette;
+        for row in patch.rows.iter_mut().filter(|row| row.cells.len() == 1) {
+            let reply = self.turn_marks.drawn.values().find_map(|drawn| {
+                (row.x == drawn.track.x && row.y >= drawn.track.y)
+                    .then(|| drawn.rows.get(usize::from(row.y - drawn.track.y)))
+                    .flatten()
+                    .copied()
+                    .flatten()
+                    .map(|message| !message)
+            });
+            if let Some(reply) = reply {
+                mark_cell(&mut row.cells[0], reply, false, palette);
+            }
+        }
+        patch
+    }
+
+    /// Where each shown pane's marks go in a frame being composed.
+    pub(super) fn turn_marks_to_draw(&self, frame: &FrameData) -> HashMap<String, DrawnMarks> {
+        self.hits
+            .panes
+            .iter()
+            .filter_map(|hit| {
+                let (track, metrics) = (hit.scrollbar_rect?, hit.scroll?);
+                let pane = self.turn_marks.panes.get(&hit.pane_id)?;
+                (!hit.popup && track.x < frame.width && !pane.marks.is_empty()).then(|| {
+                    let rows = track_rows(&pane.marks, metrics, track);
+                    let drawn = DrawnMarks {
+                        track,
+                        metrics,
+                        rows,
+                    };
+                    (hit.pane_id.clone(), drawn)
+                })
+            })
+            .collect()
+    }
+
+    /// Draw each pane's marks over its scrollbar, and the card of the mark under the mouse.
+    pub(super) fn render_turn_marks(
+        &self,
+        frame: &mut FrameData,
+        occlusion: &mut crate::kitty_graphics::surface::Occlusion,
+    ) {
+        let hovered = self.hovered_turn_mark();
+        for (index, hit) in self.hits.panes.iter().enumerate() {
+            let Some(drawn) = self.turn_marks.drawn.get(&hit.pane_id) else {
+                continue;
+            };
+            for (row, message) in (drawn.track.y..).zip(&drawn.rows) {
+                let (Some(message), true) = (*message, row < frame.height) else {
+                    continue;
+                };
+                let cell = usize::from(row) * usize::from(frame.width) + usize::from(drawn.track.x);
+                if let Some(cell) = frame.cells.get_mut(cell) {
+                    let lit = hovered == Some((index, row));
+                    mark_cell(cell, !message, lit, &self.config.palette);
+                }
+            }
+        }
+        if let Some((index, row)) = hovered {
+            self.render_turn_mark_card(frame, index, row, occlusion);
+        }
+    }
+
+    /// A card left of the scrollbar listing what is marked on its row `row`: each message
+    /// with its number among the pane's messages, and each reply.
+    fn render_turn_mark_card(
+        &self,
+        frame: &mut FrameData,
+        index: usize,
+        row: u16,
+        occlusion: &mut crate::kitty_graphics::surface::Occlusion,
+    ) {
+        let Some(hit) = self.hits.panes.get(index) else {
+            return;
+        };
+        let Some(pane) = self.turn_marks.panes.get(&hit.pane_id) else {
+            return;
+        };
+        let messages = pane.marks.iter().filter(|mark| !mark.reply).count();
+        let marked = self.turn_marks_on_row(hit, row).collect::<Vec<_>>();
+        let mut lines = marked
+            .iter()
+            .take(CARD_ROWS)
+            .map(|(place, mark)| {
+                let label = if mark.reply {
+                    REPLY_LABEL.to_owned()
+                } else {
+                    let number = pane.marks[..=*place]
+                        .iter()
+                        .filter(|mark| !mark.reply)
+                        .count();
+                    format!("#{number}/{messages}")
+                };
+                (label, mark.text.as_str())
+            })
+            .collect::<Vec<_>>();
+        let more = marked.len().saturating_sub(CARD_ROWS);
+        let more = (more > 0).then(|| format!("+{more} more"));
+        if let Some(more) = more.as_deref() {
+            lines.push((String::new(), more));
+        }
+        let label_width = lines
+            .iter()
+            .map(|(label, _)| UnicodeWidthStr::width(label.as_str()))
+            .max()
+            .unwrap_or(0);
+        let text_width = lines
+            .iter()
+            .map(|(_, text)| UnicodeWidthStr::width(*text))
+            .max()
+            .unwrap_or(0)
+            .min(CARD_TEXT_WIDTH);
+        // Borders, a space either side, and the gap after the numbers.
+        let chrome = 2 + 2 + label_width + 2;
+        let area = hit.inner_rect;
+        let width = u16::try_from(chrome + text_width)
+            .unwrap_or(u16::MAX)
+            .min(area.width);
+        let height = lines.len() as u16 + 2;
+        if usize::from(width) < chrome + 6 || height > area.height {
+            return;
+        }
+        let y = row
+            .saturating_sub(height / 2)
+            .clamp(area.y, area.bottom() - height);
+        let rect = Rect::new(area.right() - width, y, width, height);
+        let Some(mut buffer) = frame.to_ratatui_buffer() else {
+            return;
+        };
+        let palette = &self.config.palette;
+        let block = Block::bordered()
+            .border_type(BorderType::Rounded)
+            .border_style(Style::default().fg(palette.surface1))
+            .style(Style::default().bg(palette.panel_bg));
+        let inner = block.inner(rect);
+        Clear.render(rect, &mut buffer);
+        block.render(rect, &mut buffer);
+        let text_width = usize::from(width) - chrome;
+        for (line, (label, text)) in lines.iter().enumerate() {
+            let gap = label_width - UnicodeWidthStr::width(label.as_str()) + 2;
+            Paragraph::new(Line::from(vec![
+                Span::raw(" "),
+                Span::styled(
+                    format!("{label}{:gap$}", ""),
+                    Style::default().fg(palette.overlay0),
+                ),
+                Span::styled(
+                    crate::ui::truncate_end(text, text_width),
+                    Style::default().fg(palette.text),
+                ),
+            ]))
+            .render(
+                Rect::new(inner.x, inner.y + line as u16, inner.width, 1),
+                &mut buffer,
+            );
+        }
+        occlusion.cover(rect);
+        let cursor = frame.cursor.clone();
+        frame.replace_from_ratatui_buffer_preserving_effects(&buffer, cursor);
+    }
+}
+
+/// Turn a scrollbar cell into a mark: a message's or a reply's, lit under the mouse.
+fn mark_cell(cell: &mut crate::protocol::CellData, reply: bool, lit: bool, palette: &Palette) {
+    let color = match (lit, reply) {
+        (true, _) => palette.text,
+        (false, false) => palette.accent,
+        (false, true) => palette.overlay1,
+    };
+    cell.symbol = if reply { REPLY_GLYPH } else { MESSAGE_GLYPH }.into();
+    cell.fg = crate::protocol::color_to_u32(color);
+}
