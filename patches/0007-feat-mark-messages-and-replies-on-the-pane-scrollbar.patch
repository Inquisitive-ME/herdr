+/// What Claude Code printed in the scrollback, oldest first, each with its first row
+/// (counted from the top of the scrollback): the user's messages and its replies.
+///
+/// A message is a row that starts with `❯` and some text after a blank row; the prompt
+/// being typed into follows a rule instead. A reply is a row that starts with a `●` in
+/// the colour of the messages' text: a tool call's is coloured by how the call went. So
+/// replies are only told apart once the scrollback holds a message.
+fn claude_rows(terminal: &Terminal) -> Vec<(ListedKind, usize)> {
+    let total = terminal.total_rows().unwrap_or(0);
+    let starts_text = |row: usize| {
+        cell_char(terminal, 1, row).is_none_or(char::is_whitespace)
+            && cell_char(terminal, 2, row).is_some_and(|text| !text.is_whitespace())
+    };
+    let mut inputs = Vec::new();
+    let mut bullets = Vec::new();
+    for row in 0..total {
+        match cell_char(terminal, 0, row) {
+            Some(CLAUDE_USER_SIGN)
+                if starts_text(row) && (row == 0 || row_is_blank(terminal, row - 1)) =>
+            {
+                inputs.push(row);
+            }
+            Some(CLAUDE_AGENT_SIGN) if starts_text(row) => bullets.push(row),
+            _ => {}
+        }
+    }
+    let mut text_colors: Vec<(Option<CellColor>, usize)> = Vec::new();
+    for color in inputs
+        .iter()
+        .filter_map(|&row| cell_color(terminal, 2, row))
+    {
+        match text_colors.iter_mut().find(|(seen, _)| *seen == color) {
+            Some((_, count)) => *count += 1,
+            None => text_colors.push((color, 1)),
+        }
+    }
+    let text_color = text_colors
+        .into_iter()
+        .max_by_key(|(_, count)| *count)
+        .map(|(color, _)| color);
+    let mut rows = inputs
+        .into_iter()
+        .map(|row| (ListedKind::Input, row))
+        .chain(
+            bullets
+                .into_iter()
+                .filter(|&row| text_color.is_some() && cell_color(terminal, 0, row) == text_color)
+                .map(|row| (ListedKind::Reply, row)),
+        )
+        .collect::<Vec<_>>();
+    rows.sort_by_key(|(_, row)| *row);
+    rows
+}
