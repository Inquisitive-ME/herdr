+/// A patch of the pane's first row that also reports `max` rows of scrollback scrolled
+/// `offset` up, and redraws the scrollbar cell on row `scrollbar` when given.
+fn patch(max: u64, offset: u64, scrollbar: Option<u16>) -> crate::protocol::PaneSurfacePatch {
+    let cell = |symbol: &str| crate::protocol::CellData {
+        symbol: symbol.into(),
+        fg: 0,
+        bg: 0,
+        modifier: 0,
+        skip: false,
+        hyperlink: None,
+    };
+    let mut rows = vec![crate::protocol::PaneSurfacePatchRow {
+        x: 0,
+        y: 0,
+        cells: vec![cell("x")],
+    }];
+    if let Some(y) = scrollbar {
+        rows.push(crate::protocol::PaneSurfacePatchRow {
+            x: WIDTH - 1,
+            y,
+            cells: vec![cell("▐")],
+        });
+    }
+    crate::protocol::PaneSurfacePatch {
+        boot_id: "boot-1".into(),
+        projection_revision: 1,
+        base_surface_revision: 1,
+        surface_revision: 2,
+        rows,
+        panes: vec![scrolled_surface(max, offset).panes.remove(0)],
+        cursor: None,
+    }
+}
+
+/// The patch as applied to the composed frame, when it could be applied in place.
+fn in_place(
+    state: &mut ClientShellState,
+    patch: crate::protocol::PaneSurfacePatch,
+) -> Option<ClientComposedSurfacePatch> {
+    match state.apply_pane_surface_patch(patch) {
+        ClientPaneSurfacePatchOutcome::Applied(composed) => composed,
+        ClientPaneSurfacePatchOutcome::Rejected => panic!("patch rejected"),
+    }
+}
+
+#[test]
+fn a_patch_applied_in_place_keeps_the_marks_on_the_scrollbar_cells_it_redraws() {
+    let mut state = marks_state();
+    four_messages(&mut state);
+    let track = track(&state);
+
+    // The thumb moved onto the marked row 2 and the unmarked row 3.
+    let mut thumb = patch(90, 70, Some(2));
+    thumb.rows.push(crate::protocol::PaneSurfacePatchRow {
+        y: 3,
+        ..thumb.rows[1].clone()
+    });
+    let composed = in_place(&mut state, thumb).expect("applied in place");
+    let symbol = |row: u16| {
+        composed
+            .rows
+            .iter()
+            .find(|patched| patched.x == track.x && patched.y == track.y + row)
+            .map(|patched| patched.cells[0].symbol.clone())
+    };
+    assert_eq!(symbol(2).as_deref(), Some(MESSAGE_GLYPH));
+    assert_eq!(symbol(3).as_deref(), Some("▐"));
+}
+
+#[test]
+fn marks_that_new_output_moved_are_redrawn_at_the_next_tick() {
+    let mut state = marks_state();
+    four_messages(&mut state);
+    assert!(!tick(&mut state).repaint);
+
+    // One more row of output leaves every mark on its row.
+    assert!(in_place(&mut state, patch(91, 0, None)).is_some());
+    assert!(!tick(&mut state).repaint);
+
+    // Twice the scrollback: the third message's mark belongs further up.
+    let mut state = marks_state();
+    four_messages(&mut state);
+    assert!(in_place(&mut state, patch(190, 0, None)).is_some());
+    assert!(tick(&mut state).repaint);
+    state.compose(106, 20).expect("composed frame");
+    assert!(!tick(&mut state).repaint);
+}
+
+#[test]
+fn a_patch_under_a_card_recomposes() {
+    let mut state = marks_state();
+    four_messages(&mut state);
+    let moved = on_track(&state, MouseEventKind::Moved, 2);
+    state.handle_raw_events(vec![moved]);
+    state.compose(106, 20).expect("composed frame");
+    assert!(in_place(&mut state, patch(91, 0, None)).is_none());
+}
