+/// The message printed from `row` up to row `end` (both counted from the top of the
+/// scrollback): its lines up to a blank one or Claude Code's output sign, joined with
+/// spaces, without the agent's sign.
+fn message_text(terminal: &Terminal, row: usize, end: usize) -> String {
+    let Ok(rows) = terminal.screen_text_rows_range(row, end) else {
+        return String::new();
+    };
+    let text = rows
+        .iter()
+        .map(|row| row_text(row).trim().to_owned())
+        .skip_while(String::is_empty)
+        .take_while(|line| !line.is_empty() && !line.starts_with('⎿'))
+        .collect::<Vec<_>>()
+        .join(" ");
+    text.strip_prefix([CLAUDE_USER_SIGN, '>', CLAUDE_AGENT_SIGN])
+        .unwrap_or(&text)
+        .trim_start()
+        .chars()
+        .take(MESSAGE_CHARS)
+        .collect()
+}
