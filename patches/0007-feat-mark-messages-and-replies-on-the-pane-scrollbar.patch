+//! Fork: marks of the user's messages and the agent's replies on pane scrollbars.
+
+use std::time::{Duration, Instant};
+
+use super::super::turn_marks::{MESSAGE_GLYPH, REPLY_GLYPH};
+use super::*;
+use crate::api::schema::{Method, PaneListedMark, PaneListedMarkKind, ResponseResult};
+
+const WIDTH: u16 = 40;
+const TRACK: u16 = 10;
+
+fn agent_snapshot(state_change_seq: u64, agent_status: AgentStatus) -> Box<ClientShellSnapshot> {
+    let mut snapshot = snapshot();
+    snapshot.agents.push(ClientShellAgent {
+        pane_id: "pane_1".into(),
+        workspace_id: "ws_1".into(),
+        tab_id: "tab_1".into(),
+        name: None,
+        display_agent: None,
+        agent: Some("claude".into()),
+        title: None,
+        terminal_title: None,
+        terminal_title_stripped: None,
+        agent_status,
+        state_change_seq,
+        state_labels: Vec::new(),
+        tokens: Vec::new(),
+        focused: true,
+    });
+    Box::new(snapshot)
+}
+
+/// A 40x10 pane with `max` rows of scrollback above it, scrolled `offset` rows up.
+fn scrolled_surface(max: u64, offset: u64) -> PaneSurfaceFrame {
+    let mut surface = surface();
+    surface.frame = FrameData::from_ratatui_buffer_with_hyperlinks(
+        &Buffer::empty(Rect::new(0, 0, WIDTH, TRACK)),
+        None,
+        &[],
+    );
+    let pane = &mut surface.panes[0];
+    pane.rect = SurfaceRect {
+        x: 0,
+        y: 0,
+        width: WIDTH,
+        height: TRACK,
+    };
+    pane.inner_rect = SurfaceRect {
+        width: WIDTH - 1,
+        ..pane.rect
+    };
+    pane.scrollbar_rect = Some(SurfaceRect {
+        x: WIDTH - 1,
+        width: 1,
+        ..pane.rect
+    });
+    pane.scroll = Some(crate::protocol::PaneSurfaceScrollMetrics {
+        offset_from_bottom: offset,
+        max_offset_from_bottom: max,
+        viewport_rows: u64::from(TRACK),
+    });
+    surface
+}
+
+/// A pane at the bottom of 100 rows, so each of its ten scrollbar rows stands for ten,
+/// whose agent is in `agent_status`.
+fn marks_state_with(agent_status: AgentStatus) -> ClientShellState {
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(agent_snapshot(1, agent_status));
+    state.set_endpoint_methods(Some(vec![
+        "pane.focus".into(),
+        "pane.mark.list".into(),
+        "pane.scroll".into(),
+    ]));
+    state.set_pane_surface(scrolled_surface(90, 0));
+    state.compose(106, 20).expect("composed frame");
+    state
+}
+
+fn marks_state() -> ClientShellState {
+    marks_state_with(AgentStatus::Working)
+}
+
+fn tick_at(state: &mut ClientShellState, now: Instant) -> ClientShellInput {
+    let mut outcome = ClientShellInput::default();
+    state.tick_turn_marks(now, &mut outcome);
+    outcome
+}
+
+fn tick(state: &mut ClientShellState) -> ClientShellInput {
+    tick_at(state, Instant::now())
+}
+
+/// The id of the one `pane.mark.list` request in `outcome`.
+fn list_request(outcome: &ClientShellInput) -> String {
+    let [ClientShellAction::Endpoint { request, .. }] = &outcome.actions[..] else {
+        panic!("expected one request, got {}", outcome.actions.len());
+    };
+    assert!(matches!(
+        &request.method,
+        Method::PaneMarkList(target) if target.pane_id == "pane_1"
+    ));
+    request.id.clone()
+}
+
+fn message(row: u64, text: &str) -> PaneListedMark {
+    PaneListedMark {
+        kind: PaneListedMarkKind::Input,
+        row,
+        text: text.into(),
+    }
+}
+
+fn reply(row: u64, text: &str) -> PaneListedMark {
+    PaneListedMark {
+        kind: PaneListedMarkKind::Reply,
+        ..message(row, text)
+    }
+}
+
+/// Ask for the pane's list at `now` and answer with `marks`; whether that asks for a repaint.
+fn list_marks_at(state: &mut ClientShellState, now: Instant, marks: Vec<PaneListedMark>) -> bool {
+    let id = list_request(&tick_at(state, now));
+    let (repaint, actions) =
+        state.handle_endpoint_result("boot-1", &id, Ok(ResponseResult::PaneMarkList { marks }));
+    assert!(actions.is_empty());
+    repaint
+}
+
+/// Messages on scrollback rows 21 and 23 (both on scrollbar row 2), 61 (row 6) and, in
+/// the last screen, 95 (row 9, where the thumb is), listed and drawn.
+fn four_messages(state: &mut ClientShellState) {
+    let marks = vec![
+        message(21, "first question"),
+        message(23, "second question"),
+        message(61, "third question"),
+        message(95, "newest question"),
+    ];
+    assert!(list_marks_at(state, Instant::now(), marks));
+    state.compose(106, 20).expect("composed frame");
+}
+
+fn track(state: &ClientShellState) -> Rect {
+    state.hits.panes[0].scrollbar_rect.expect("scrollbar track")
+}
+
+fn on_track(state: &ClientShellState, kind: MouseEventKind, row: u16) -> RawInputEvent {
+    let track = track(state);
+    RawInputEvent::Mouse(MouseEvent {
+        kind,
+        column: track.x,
+        row: track.y + row,
+        modifiers: KeyModifiers::empty(),
+    })
+}
+
+fn track_cell(state: &ClientShellState, frame: &FrameData, row: u16) -> crate::protocol::CellData {
+    let track = track(state);
+    frame.cells[usize::from(track.y + row) * usize::from(frame.width) + usize::from(track.x)]
+        .clone()
+}
+
+fn color(color: ratatui::style::Color) -> u32 {
+    crate::protocol::color_to_u32(color)
+}
+
+fn scroll_offset(outcome: &ClientShellInput) -> Option<u64> {
+    outcome.actions.iter().find_map(|action| match action {
+        ClientShellAction::Endpoint { request, .. } => match &request.method {
+            Method::PaneScroll(params) => Some(params.offset_from_bottom),
+            _ => None,
+        },
+        _ => None,
+    })
+}
