+    fn send_lines(terminal: &mut Terminal, marks: &mut TurnMarks, printed: &str) {
+        terminal.write(b"welcome\r\n");
+        prompt(terminal);
+        marks.mark_idle(terminal, false);
+        marks.note_typed();
+        terminal.write(b"\r\x1b[3A\x1b[J");
