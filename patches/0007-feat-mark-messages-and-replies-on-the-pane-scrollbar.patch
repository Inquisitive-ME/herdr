+#[test]
+fn hovering_a_mark_lists_what_is_on_its_row_in_a_card_and_lights_the_mark() {
+    let mut state = marks_state();
+    let marks = vec![
+        message(21, "first question"),
+        reply(23, "It works like this."),
+        message(61, "third question"),
+    ];
+    assert!(list_marks_at(&mut state, Instant::now(), marks));
+    state.compose(106, 20).expect("composed frame");
+
+    let moved = on_track(&state, MouseEventKind::Moved, 2);
+    assert!(state.handle_raw_events(vec![moved]).repaint);
+    let frame = state.compose(106, 20).expect("composed frame");
+    let rows = frame_rows(&frame);
+    assert!(rows.iter().any(|row| row.contains("#1/2  first question")));
+    assert!(rows
+        .iter()
+        .any(|row| row.contains("●     It works like this.")));
+    assert!(!rows.iter().any(|row| row.contains("third question")));
+    assert_eq!(
+        track_cell(&state, &frame, 2).fg,
+        color(state.config.palette.text)
+    );
+
+    let moved = on_track(&state, MouseEventKind::Moved, 4);
+    assert!(state.handle_raw_events(vec![moved]).repaint);
+    let frame = state.compose(106, 20).expect("composed frame");
+    assert!(!frame_rows(&frame)
+        .iter()
+        .any(|row| row.contains("first question")));
+}
