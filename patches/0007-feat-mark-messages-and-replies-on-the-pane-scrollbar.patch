+    /// A message, a reply and a tool call as Claude Code prints them (its dark theme),
+    /// each after a blank row.
+    fn claude_message(text: &str) -> String {
+        format!(
+            "\r\n\x1b[38;2;153;153;153m\x1b[48;2;55;55;55m❯ \x1b[0m\x1b[38;2;255;255;255m\x1b[48;2;55;55;55m{text}\x1b[0m\r\n"
+        )
+    }
+
+    fn claude_reply(text: &str) -> String {
+        format!("\r\n\x1b[38;2;255;255;255m● \x1b[0m{text}\r\n")
+    }
+
+    fn claude_tool(call: &str, output: &str) -> String {
+        format!("\r\n\x1b[38;2;78;186;101m● \x1b[0m\x1b[1m{call}\x1b[0m\r\n  ⎿  {output}\r\n")
+    }
+
+    /// Two messages with replies and tool calls between them, then the prompt: more than
+    /// a screenful, none of it watched by a `TurnMarks`.
+    fn claude_history(terminal: &mut Terminal) {
+        for printed in [
+            claude_message("how does it work?"),
+            claude_tool("Read(src/lib.rs)", "Read 20 lines"),
+            claude_reply("It reads the rows."),
+            claude_tool("Bash(ls)", "3 files"),
+            claude_reply("And then it lists them."),
+            claude_message("thanks"),
+        ] {
+            terminal.write(printed.as_bytes());
+        }
+        terminal.write(b"\r\n");
+        prompt(terminal);
+    }
+
+    #[test]
+    fn claude_code_scrollback_lists_its_messages_and_replies_without_marks() {
+        let mut terminal = terminal();
+        claude_history(&mut terminal);
+
+        let listed = TurnMarks::default().listed(&terminal, true);
+        assert_eq!(
+            listed
+                .iter()
+                .map(|mark| (mark.kind, mark.text.as_str()))
+                .collect::<Vec<_>>(),
+            [
+                (ListedKind::Input, "how does it work?"),
+                (ListedKind::Reply, "It reads the rows."),
+                (ListedKind::Reply, "And then it lists them."),
+                (ListedKind::Input, "thanks"),
+            ]
+        );
+        assert_eq!(row(&terminal, listed[0].row), "❯ how does it work?");
+        assert_eq!(row(&terminal, listed[2].row), "● And then it lists them.");
+        // Another agent's pane only lists what the server marked.
+        assert_eq!(TurnMarks::default().listed(&terminal, false), Vec::new());
+    }
