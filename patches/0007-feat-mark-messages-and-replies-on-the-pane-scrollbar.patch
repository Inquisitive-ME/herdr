+    /// Fork: whether the pane's agent is Claude Code, whose messages and replies can be
+    /// found in the scrollback as printed.
+    fn fork_pane_runs_claude(&self, ws_idx: usize, pane_id: PaneId) -> bool {
+        self.state
+            .workspaces
+            .get(ws_idx)
+            .and_then(|ws| ws.pane_state(pane_id))
+            .and_then(|pane| self.state.terminals.get(&pane.attached_terminal_id))
+            .and_then(|terminal| terminal.effective_agent_label())
+            == Some("claude")
+    }
+
+    /// Fork: the messages in a pane's scrollback.
+    pub(super) fn handle_pane_mark_list(&mut self, id: String, target: PaneTarget) -> String {
+        let Some((ws_idx, pane_id)) = self.parse_pane_id(&target.pane_id) else {
+            return pane_not_found(id, &target.pane_id);
+        };
+        let Some(runtime) =
+            self.state
+                .runtime_for_pane_in_workspace(&self.terminal_runtimes, ws_idx, pane_id)
+        else {
+            return pane_not_found(id, &target.pane_id);
+        };
+        use crate::api::schema::{PaneListedMark, PaneListedMarkKind};
+        use crate::pane::turn_marks::ListedKind;
+        let marks = runtime
+            .fork_listed_marks(self.fork_pane_runs_claude(ws_idx, pane_id))
+            .into_iter()
+            .map(|mark| PaneListedMark {
+                kind: match mark.kind {
+                    ListedKind::Input => PaneListedMarkKind::Input,
+                    ListedKind::Reply => PaneListedMarkKind::Reply,
+                },
+                row: mark.row as u64,
+                text: mark.text,
+            })
+            .collect();
+        encode_success(id, ResponseResult::PaneMarkList { marks })
+    }
+
     pub(super) fn handle_pane_edit_scrollback(&mut self, id: String, target: PaneTarget) -> String {
         let Some((ws_idx, pane_id)) = self.parse_pane_id(&target.pane_id) else {
             return pane_not_found(id, &target.pane_id);
