+/// The first character of the cell in column `x` of `row` (counted from the top of the
+/// scrollback); None for an empty cell.
+fn cell_char(terminal: &Terminal, x: u16, row: usize) -> Option<char> {
+    let (_, graphemes) = terminal.screen_cell(x, u32::try_from(row).ok()?).ok()?;
+    char::from_u32(*graphemes.first()?)
+}
+
+/// The text colour of a cell; the inner None is the terminal's own text colour.
+fn cell_color(terminal: &Terminal, x: u16, row: usize) -> Option<Option<CellColor>> {
+    let style = terminal
+        .screen_cell_style(x, u32::try_from(row).ok()?)
+        .ok()?;
+    Some(style.fg_color)
+}
+
+fn row_is_blank(terminal: &Terminal, row: usize) -> bool {
+    let Ok(row) = u32::try_from(row) else {
+        return false;
+    };
+    let mut blank = true;
+    let visited = terminal.for_each_screen_row_cell(row, |_, graphemes| {
+        blank &= graphemes
+            .iter()
+            .all(|&code| char::from_u32(code).is_none_or(char::is_whitespace));
+    });
+    visited.is_ok() && blank
+}
