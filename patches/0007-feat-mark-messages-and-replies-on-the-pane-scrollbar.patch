+
+    state.handle_endpoint_result(
+        "boot-1",
+        &id,
+        Ok(ResponseResult::PaneMarkList { marks: Vec::new() }),
+    );
+    assert!(tick(&mut state).actions.is_empty(), "listed for this state");
+
+    // The agent went idle or started working: the server may have added a mark.
+    state.set_snapshot(agent_snapshot(2, AgentStatus::Working));
+    state.set_pane_surface(scrolled_surface(90, 0));
