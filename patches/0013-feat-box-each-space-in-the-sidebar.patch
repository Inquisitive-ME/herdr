diff --git a/src/client/shell/space_agents.rs b/src/client/shell/space_agents.rs
index b92c2c0d..aea11d62 100644
--- a/src/client/shell/space_agents.rs
+++ b/src/client/shell/space_agents.rs
@@ -717,6 +717,134 @@ pub(in crate::client::shell) fn render_space_tree(
     None
 }
 
+/// Narrower sidebars keep their columns for text and go without boxes.
+const MIN_BOXED_SIDEBAR_WIDTH: u16 = 12;
+
+/// Whether a sidebar this wide boxes its spaces.
+pub(in crate::client::shell) fn spaces_boxed(sidebar_width: u16) -> bool {
+    sidebar_width >= MIN_BOXED_SIDEBAR_WIDTH
+}
+
+/// Rows a space's box adds to its list entry: the border above a top-level space, and
+/// the bottom border under the last space of a list.
+pub(in crate::client::shell) fn space_box_rows(boxed: bool, indented: bool, last: bool) -> u16 {
+    if boxed {
+        u16::from(!indented) + u16::from(last)
+    } else {
+        0
+    }
+}
+
+/// Draws a box around each space in the spaces list, top to bottom. Neighbouring spaces
+/// share a border row; a worktree's child spaces sit inside their parent's box.
+pub(in crate::client::shell) struct SpaceBoxes {
+    x: u16,
+    width: u16,
+    boxed: bool,
+    open: bool,
+}
+
+impl SpaceBoxes {
+    /// Boxes spanning columns `x..x + width`; unboxed, spaces use those columns as they are.
+    pub(in crate::client::shell) fn new(x: u16, width: u16, boxed: bool) -> Self {
+        Self {
+            x,
+            width,
+            boxed,
+            open: false,
+        }
+    }
+
+    /// Border rows drawn above the next space.
+    pub(in crate::client::shell) fn border_rows(&self, indented: bool) -> u16 {
+        u16::from(self.boxed && !(indented && self.open))
+    }
+
+    /// Start a space at row `y`, under a `╭─╮` or a shared `├─┤` border unless it
+    /// continues its parent's box. Returns the row its content starts on.
+    pub(in crate::client::shell) fn start(
+        &mut self,
+        buffer: &mut Buffer,
+        y: u16,
+        indented: bool,
+        palette: &Palette,
+    ) -> u16 {
+        if self.border_rows(indented) == 0 {
+            return y;
+        }
+        let corners = if self.open {
+            ("├", "┤")
+        } else {
+            ("╭", "╮")
+        };
+        self.border(buffer, y, corners, palette);
+        self.open = true;
+        y.saturating_add(1)
+    }
+
+    /// Draw the walls beside rows `y..y + height` and return the area between them.
+    pub(in crate::client::shell) fn inner(
+        &self,
+        buffer: &mut Buffer,
+        y: u16,
+        height: u16,
+        palette: &Palette,
+    ) -> Rect {
+        if !self.boxed {
+            return Rect::new(self.x, y, self.width, height);
+        }
+        let style = Style::default().fg(palette.surface1);
+        for row in y..y.saturating_add(height) {
+            put_text(buffer, self.x, row, 1, "│", style);
+            put_text(
+                buffer,
+                self.x + self.width.saturating_sub(1),
+                row,
+                1,
+                "│",
+                style,
+            );
+        }
+        Rect::new(
+            self.x.saturating_add(1),
+            y,
+            self.width.saturating_sub(2),
+            height,
+        )
+    }
+
+    /// Close an open box on row `y` if it is above `bottom`. Returns the next free row.
+    pub(in crate::client::shell) fn finish(
+        &mut self,
+        buffer: &mut Buffer,
+        y: u16,
+        bottom: u16,
+        palette: &Palette,
+    ) -> u16 {
+        if !self.open || y >= bottom {
+            return y;
+        }
+        self.border(buffer, y, ("╰", "╯"), palette);
+        self.open = false;
+        y.saturating_add(1)
+    }
+
+    fn border(&self, buffer: &mut Buffer, y: u16, (left, right): (&str, &str), palette: &Palette) {
+        if self.width < 2 {
+            return;
+        }
+        let line = format!("{left}{}{right}", "─".repeat(usize::from(self.width - 2)));
+        put_text(
+            buffer,
+            self.x,
+            y,
+            self.width,
+            &line,
+            Style::default().fg(palette.surface1),
+        );
+    }
+}
