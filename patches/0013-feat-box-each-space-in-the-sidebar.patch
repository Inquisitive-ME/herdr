+
+fn cell(frame: &FrameData, x: u16, y: u16) -> &str {
+    &frame.cells[usize::from(y) * usize::from(frame.width) + usize::from(x)].symbol
+}
+
+#[test]
+fn each_space_sits_in_a_box_sharing_borders_with_its_neighbours() {
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(Box::new(tree_snapshot()));
+    state.set_pane_surface(surface());
+    let frame = state.compose(106, 30).expect("frame");
+    let first = space(&state, "ws_1");
+    let second = space(&state, "ws_2");
+    let deploy = line(&state, "pane_2");
+    let last = line(&state, "pane_3");
+    let edges = |y| (cell(&frame, first.x - 1, y), cell(&frame, first.right(), y));
+    assert_eq!(edges(first.y - 1), ("╭", "╮"));
+    assert_eq!(edges(deploy.y), ("│", "│"));
+    assert_eq!(second.y - 1, deploy.bottom());
+    assert_eq!(edges(second.y - 1), ("├", "┤"));
+    assert_eq!(edges(last.bottom()), ("╰", "╯"));
+}
+
+#[test]
+fn each_machine_closes_its_spaces_box_before_the_next_machine() {
+    let (mut state, remote) = multi_machine_state(AgentStatus::Working);
+    let frame = state.compose(106, 40).expect("frame");
+    let local_last = machine_line(
+        &state,
+        &crate::client::endpoint::ClientEndpointId::Local,
+        "pane_3",
+    );
+    let remote_first = machine_line(&state, &remote, "pane_1");
+    let remote_space = state
+        .hits
+        .workspaces
+        .iter()
+        .find(|hit| hit.endpoint_id == remote && hit.workspace_id == "ws_1")
+        .map(|hit| hit.rect)
+        .expect("remote space");
+    let edges = |line: Rect, y| (cell(&frame, line.x - 1, y), cell(&frame, line.right(), y));
+    assert_eq!(edges(local_last, local_last.bottom()), ("╰", "╯"));
+    assert!(state
+        .hits
+        .machines
+        .iter()
+        .any(|machine| machine.endpoint_id == remote && machine.rect.y == local_last.bottom() + 1));
+    assert_eq!(edges(remote_first, remote_space.y - 1), ("╭", "╮"));
+    assert_eq!(edges(remote_first, remote_first.y), ("│", "│"));
+}
