diff --git a/src/client/shell/space_agents.rs b/src/client/shell/space_agents.rs
new file mode 100644
index 00000000..c41de194
--- /dev/null
+++ b/src/client/shell/space_agents.rs
@@ -0,0 +1,220 @@
+//! Fork addition: each space lists its agents under it in the expanded sidebar,
+//! and the bottom agent section only shows agents that need input.
+//!
+//! Lives in its own file so upstream sidebar changes rarely conflict with it.
+
+use ratatui::{
+    text::{Line, Span},
+    widgets::{Paragraph, Widget},
+};
+
+use super::*;
+use crate::api::schema::AgentStatus;
+use crate::protocol::ClientShellAgent;
+
+/// Rows the agent section draws above its list: divider, title, blank line.
+const NEEDS_INPUT_HEADER_ROWS: u16 = 3;
+
+/// Whether an agent belongs in the bottom "needs input" section.
+pub(in crate::client::shell) fn needs_input(status: AgentStatus) -> bool {
+    status == AgentStatus::Blocked
+}
+
+/// The agents in one space, in the agent panel's grouped order.
+pub(in crate::client::shell) fn space_agents<'a>(
+    snapshot: &'a ClientShellSnapshot,
+    workspace_id: &str,
+) -> Vec<&'a ClientShellAgent> {
+    snapshot
+        .agents
+        .iter()
+        .filter(|agent| agent.workspace_id == workspace_id)
+        .collect()
+}
+
+pub(in crate::client::shell) fn space_agent_count(
+    snapshot: &ClientShellSnapshot,
+    workspace_id: &str,
+) -> u16 {
+    snapshot
+        .agents
+        .iter()
+        .filter(|agent| agent.workspace_id == workspace_id)
+        .count()
+        .min(u16::MAX as usize) as u16
+}
+
+/// A named tab says the most about an agent; otherwise use the agent's own title.
+fn agent_label<'a>(snapshot: &'a ClientShellSnapshot, agent: &'a ClientShellAgent) -> &'a str {
+    snapshot
+        .tabs
+        .iter()
+        .find(|tab| tab.tab_id == agent.tab_id && tab.custom_label)
+        .map(|tab| tab.label.as_str())
+        .or(agent.name.as_deref())
+        .or(agent
+            .terminal_title_stripped
+            .as_deref()
+            .filter(|title| !title.is_empty()))
+        .or(agent.display_agent.as_deref())
+        .or(agent.agent.as_deref())
+        .unwrap_or(agent.pane_id.as_str())
+}
+
+/// Draw one line per agent from the top of `area`, calling `on_line` with each line's
+/// rect so the caller can register it as a click target.
+#[allow(clippy::too_many_arguments)] // mirrors the other sidebar row renderers
+pub(in crate::client::shell) fn render_space_agents(
+    buffer: &mut Buffer,
+    area: Rect,
+    indent: u16,
+    snapshot: &ClientShellSnapshot,
+    agents: &[&ClientShellAgent],
+    show_focus: bool,
+    config: &ClientShellConfig,
+    mut on_line: impl FnMut(Rect, &ClientShellAgent),
+) {
+    let palette = &config.palette;
+    for (index, agent) in agents.iter().enumerate() {
+        let y = area.y.saturating_add(index.min(u16::MAX as usize) as u16);
+        if y >= area.bottom() {
+            break;
+        }
+        let line = Rect::new(area.x, y, area.width, 1);
+        let focused = show_focus && agent.focused;
+        if focused {
+            buffer.set_style(line, Style::default().bg(palette.active_row_bg));
+        }
+        let label_style = if focused {
+            Style::default()
+                .fg(palette.text)
+                .add_modifier(Modifier::BOLD)
+        } else {
+            Style::default().fg(palette.subtext0)
+        };
+        let x = line.x.saturating_add(indent).min(line.right());
+        Paragraph::new(Line::from(vec![
+            Span::styled(
+                status_icon(agent.agent_status, config.status_indicators),
+                Style::default().fg(status_color(agent.agent_status, palette)),
+            ),
+            Span::raw(" "),
+            Span::styled(agent_label(snapshot, agent), label_style),
+        ]))
+        .render(Rect::new(x, y, line.right().saturating_sub(x), 1), buffer);
+        on_line(line, agent);
+    }
+}
+
+/// Total height of a list of entries separated by `row_gap`.
+pub(in crate::client::shell) fn list_height(heights: impl Iterator<Item = u16>, row_gap: u16) -> u16 {
+    let mut total = 0u16;
+    for (index, height) in heights.enumerate() {
+        if index > 0 {
+            total = total.saturating_add(row_gap);
+        }
+        total = total.saturating_add(height.max(1));
+    }
+    total
+}
+
+/// Height of the local "needs input" list.
+pub(in crate::client::shell) fn local_needs_input_height(
+    snapshot: &ClientShellSnapshot,
+    config: &ClientShellConfig,
+) -> u16 {
+    list_height(
+        super::agent_sidebar::agent_rows(snapshot, config, None)
+            .iter()
+            .filter(|row| needs_input(row.status))
+            .map(|row| row.rows.len().min(u16::MAX as usize) as u16),
+        config.agents.row_gap,
+    )
+}
+
+/// Split the expanded sidebar into (spaces, needs input, divider). The needs-input
+/// section takes room only while an agent needs input: just enough for its rows, up to
+/// the user's draggable split. Without it, the bottom row stays free for the sidebar's
+/// collapse toggle and there is no divider to drag.
+pub(in crate::client::shell) fn sidebar_sections(
+    area: Rect,
+    split_ratio: f32,
+    needs_input_height: u16,
+) -> (Rect, Rect, Rect) {
+    let (upstream_spaces, upstream_detail) =
+        crate::ui::expanded_sidebar_sections(area, split_ratio);
+    let content = upstream_spaces.union(upstream_detail);
+    if content.is_empty() {
+        return (Rect::default(), Rect::default(), Rect::default());
+    }
+    if needs_input_height == 0 {
+        let spaces = Rect::new(
+            content.x,
+            content.y,
+            content.width,
+            content.height.saturating_sub(1),
+        );
+        let detail = Rect::new(content.x, spaces.bottom(), content.width, 0);
+        return (spaces, detail, Rect::default());
+    }
+    let detail_height = NEEDS_INPUT_HEADER_ROWS
+        .saturating_add(needs_input_height)
+        .min(upstream_detail.height);
+    let spaces_height = content.height.saturating_sub(detail_height);
+    let spaces = Rect::new(content.x, content.y, content.width, spaces_height);
+    let detail = Rect::new(content.x, spaces.bottom(), content.width, detail_height);
+    let divider = if crate::ui::sidebar_section_divider_rect(area, split_ratio).is_empty() {
+        Rect::default()
+    } else {
+        Rect::new(detail.x, detail.y, detail.width, 1)
+    };
+    (spaces, detail, divider)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn needs_input_is_only_blocked() {
+        assert!(needs_input(AgentStatus::Blocked));
+        for status in [
+            AgentStatus::Working,
+            AgentStatus::Done,
+            AgentStatus::Idle,
+            AgentStatus::Unknown,
+        ] {
+            assert!(!needs_input(status));
+        }
+    }
+
+    #[test]
+    fn list_height_adds_gaps_between_entries() {
+        assert_eq!(list_height([].into_iter(), 1), 0);
+        assert_eq!(list_height([2].into_iter(), 1), 2);
+        assert_eq!(list_height([2, 0, 3].into_iter(), 1), 2 + 1 + 1 + 1 + 3);
+    }
+
+    #[test]
+    fn sections_give_spaces_everything_but_the_toggle_row_without_waiting_agents() {
+        let area = Rect::new(0, 0, 27, 40);
+        let (spaces, detail, divider) = sidebar_sections(area, 0.5, 0);
+        assert_eq!(spaces, Rect::new(0, 0, 26, 39));
+        assert_eq!(detail.height, 0);
+        assert!(divider.is_empty());
+    }
+
+    #[test]
+    fn needs_input_section_fits_its_rows_up_to_the_split() {
+        let area = Rect::new(0, 0, 27, 40);
+        let (spaces, detail, divider) = sidebar_sections(area, 0.5, 4);
+        assert_eq!(detail, Rect::new(0, 33, 26, 7));
+        assert_eq!(spaces.height + detail.height, 40);
+        assert_eq!(divider, Rect::new(0, 33, 26, 1));
+
+        let (_, detail, _) = sidebar_sections(area, 0.5, 100);
+        assert_eq!(detail.height, 20);
+        let (_, detail, _) = sidebar_sections(area, 0.25, 100);
+        assert_eq!(detail.height, 30);
+    }
+}
