From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Richard Swanson <rswanson05@gmail.com>
Date: Sat, 7 Nov 2026 22:01:02 -0600
Subject: [PATCH] feat: show an agent's running shell count in the space tree
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Agent lines under a space append "· N shells" from the pane's shells
token, shortening the label so the count stays visible. The token is
reported by the herdr-shell-count watcher in the patch repo's extras.

diff --git a/src/client/shell/space_agents.rs b/src/client/shell/space_agents.rs
index c41de194..61175b8e 100644
--- a/src/client/shell/space_agents.rs
+++ b/src/client/shell/space_agents.rs
@@ -61,6 +61,21 @@ fn agent_label<'a>(snapshot: &'a ClientShellSnapshot, agent: &'a ClientShellAgen
         .unwrap_or(agent.pane_id.as_str())
 }
 
+/// "2 shells" from the `shells` pane token, which the herdr-shell-count watcher reports
+/// with the number of shell commands the agent process is running.
+fn shell_count_text(agent: &ClientShellAgent) -> Option<String> {
+    let count = agent
+        .tokens
+        .iter()
+        .find(|(name, _)| name == "shells")
+        .and_then(|(_, value)| value.trim().parse::<u32>().ok())
+        .filter(|count| *count > 0)?;
+    Some(format!(
+        " · {count} shell{}",
+        if count == 1 { "" } else { "s" }
+    ))
+}
+
 /// Draw one line per agent from the top of `area`, calling `on_line` with each line's
 /// rect so the caller can register it as a click target.
 #[allow(clippy::too_many_arguments)] // mirrors the other sidebar row renderers
@@ -93,15 +108,27 @@ pub(in crate::client::shell) fn render_space_agents(
             Style::default().fg(palette.subtext0)
         };
         let x = line.x.saturating_add(indent).min(line.right());
-        Paragraph::new(Line::from(vec![
+        let icon = status_icon(agent.agent_status, config.status_indicators);
+        let shells = shell_count_text(agent).unwrap_or_default();
+        // Shorten the label rather than let the shell count fall off the edge.
+        let label_width = usize::from(line.right().saturating_sub(x))
+            .saturating_sub(UnicodeWidthStr::width(icon) + 1 + UnicodeWidthStr::width(shells.as_str()));
+        let mut spans = vec![
             Span::styled(
-                status_icon(agent.agent_status, config.status_indicators),
+                icon,
                 Style::default().fg(status_color(agent.agent_status, palette)),
             ),
             Span::raw(" "),
-            Span::styled(agent_label(snapshot, agent), label_style),
-        ]))
-        .render(Rect::new(x, y, line.right().saturating_sub(x), 1), buffer);
+            Span::styled(
+                crate::ui::truncate_end(agent_label(snapshot, agent), label_width),
+                label_style,
+            ),
+        ];
+        if !shells.is_empty() {
+            spans.push(Span::styled(shells, Style::default().fg(palette.overlay0)));
+        }
+        Paragraph::new(Line::from(spans))
+            .render(Rect::new(x, y, line.right().saturating_sub(x), 1), buffer);
         on_line(line, agent);
     }
 }
@@ -188,6 +215,43 @@ mod tests {
         }
     }
 
+    fn agent_with_tokens(tokens: &[(&str, &str)]) -> ClientShellAgent {
+        ClientShellAgent {
+            pane_id: "w1:p1".into(),
+            workspace_id: "w1".into(),
+            tab_id: "w1:t1".into(),
+            name: None,
+            display_agent: None,
+            agent: Some("claude".into()),
+            title: None,
+            terminal_title: None,
+            terminal_title_stripped: None,
+            agent_status: AgentStatus::Working,
+            state_change_seq: 0,
+            state_labels: Vec::new(),
+            tokens: tokens
+                .iter()
+                .map(|(name, value)| (name.to_string(), value.to_string()))
+                .collect(),
+            focused: false,
+        }
+    }
+
+    #[test]
+    fn shell_count_comes_from_the_shells_token() {
+        assert_eq!(shell_count_text(&agent_with_tokens(&[])), None);
+        assert_eq!(shell_count_text(&agent_with_tokens(&[("shells", "0")])), None);
+        assert_eq!(shell_count_text(&agent_with_tokens(&[("shells", "x")])), None);
+        assert_eq!(
+            shell_count_text(&agent_with_tokens(&[("shells", "1")])).as_deref(),
+            Some(" · 1 shell")
+        );
+        assert_eq!(
+            shell_count_text(&agent_with_tokens(&[("other", "9"), ("shells", "2")])).as_deref(),
+            Some(" · 2 shells")
+        );
+    }
+
     #[test]
     fn list_height_adds_gaps_between_entries() {
         assert_eq!(list_height([].into_iter(), 1), 0);
