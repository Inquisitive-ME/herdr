From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Richard Swanson <rswanson05@gmail.com>
Date: Sun, 8 Nov 2026 07:00:49 -0600
Subject: [PATCH] feat: report when an agent's state began and let clients move
 panes

Agents carry a state_since_ms token with the wall-clock time of their last state change, so clients can show how long an agent has been working, waiting or done. pane.move joins the client shell methods so the sidebar can move agents between spaces.

diff --git a/src/app/actions.rs b/src/app/actions.rs
index f01dd05b..503c8fd4 100644
--- a/src/app/actions.rs
+++ b/src/app/actions.rs
@@ -1756,6 +1756,10 @@ impl AppState {
             self.next_agent_state_change_seq += 1;
             if let Some(terminal) = self.terminals.get_mut(&terminal_id) {
                 terminal.last_agent_state_change_seq = Some(self.next_agent_state_change_seq);
+                terminal.agent_state_since_unix_ms = std::time::SystemTime::now()
+                    .duration_since(std::time::UNIX_EPOCH)
+                    .ok()
+                    .and_then(|elapsed| u64::try_from(elapsed.as_millis()).ok());
                 terminal.last_agent_completion_seq = (!suppress_completion
                     && is_completion_transition(&change))
                 .then_some(self.next_agent_state_change_seq);
@@ -3165,6 +3169,48 @@ mod tests {
         app.assert_invariants_for_test();
     }
 
+    /// Fork: agents carry when their current state began, for the sidebar's ages.
+    #[test]
+    fn state_changes_record_when_the_state_began() {
+        let mut app = app_with_workspaces(&["active"]);
+        let pane_id = app.workspaces[0].tabs[0].root_pane;
+        let terminal_id = app.workspaces[0].panes[&pane_id]
+            .attached_terminal_id
+            .clone();
+        let before = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map(|elapsed| elapsed.as_millis() as u64)
+            .unwrap_or_default();
+        let change = |app: &mut AppState, state| {
+            app.handle_app_event(AppEvent::StateChanged {
+                pane_id,
+                agent: Some(Agent::Pi),
+                state,
+                visible_blocker: false,
+                visible_working: state == AgentState::Working,
+                process_exited: false,
+                observed_at: Instant::now(),
+            });
+        };
+        change(&mut app, AgentState::Working);
+        let since = app.terminals[&terminal_id].agent_state_since_unix_ms;
+        assert!(since.is_some_and(|since| since >= before));
+        // Repeating the same state keeps the original start.
+        app.terminals
+            .get_mut(&terminal_id)
+            .expect("terminal")
+            .agent_state_since_unix_ms = Some(1);
+        change(&mut app, AgentState::Working);
+        assert_eq!(
+            app.terminals[&terminal_id].agent_state_since_unix_ms,
+            Some(1)
+        );
+        change(&mut app, AgentState::Idle);
+        assert!(app.terminals[&terminal_id]
+            .agent_state_since_unix_ms
+            .is_some_and(|since| since >= before));
+    }
+
     #[test]
     fn completion_guard_unknown_to_idle_is_not_completed_work() {
         assert_completion_guard_sequence(false, &[AgentState::Unknown, AgentState::Idle], false);
