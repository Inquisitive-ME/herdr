+    #[test]
+    fn fork_git_branch_is_read_once_per_folder_every_few_seconds() {
+        let repo = std::env::temp_dir().join(format!("herdr-branch-{}", std::process::id()));
+        let git = repo.join(".git");
+        std::fs::create_dir_all(git.join("refs/heads")).unwrap();
+        std::fs::write(git.join("HEAD"), "ref: refs/heads/feature/card\n").unwrap();
+        let dir = repo.to_str().unwrap();
+        assert_eq!(cached_git_branch(dir).as_deref(), Some("feature/card"));
+        // A checkout shows up on a later read, not on every frame.
+        std::fs::write(git.join("HEAD"), "ref: refs/heads/main\n").unwrap();
+        assert_eq!(cached_git_branch(dir).as_deref(), Some("feature/card"));
+        assert_eq!(cached_git_branch("/nonexistent/herdr/dir"), None);
+        std::fs::remove_dir_all(&repo).unwrap();
+    }
