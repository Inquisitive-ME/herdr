+/// Fork: the git branch checked out in `dir`. Snapshots are rebuilt every frame, so each
+/// folder is read at most every few seconds.
+fn cached_git_branch(dir: &str) -> Option<String> {
+    use std::collections::BTreeMap;
+    use std::sync::Mutex;
+    use std::time::{Duration, Instant};
+    const FRESH_FOR: Duration = Duration::from_secs(3);
+    static CACHE: Mutex<BTreeMap<String, (Instant, Option<String>)>> = Mutex::new(BTreeMap::new());
+    let mut cache = CACHE
+        .lock()
+        .unwrap_or_else(|poisoned| poisoned.into_inner());
+    if let Some((read_at, branch)) = cache.get(dir) {
+        if read_at.elapsed() < FRESH_FOR {
+            return branch.clone();
+        }
+    }
+    cache.retain(|_, (read_at, _)| read_at.elapsed() < FRESH_FOR);
+    let branch = crate::workspace::git_branch(std::path::Path::new(dir));
+    cache.insert(dir.to_owned(), (Instant::now(), branch.clone()));
+    branch
+}
