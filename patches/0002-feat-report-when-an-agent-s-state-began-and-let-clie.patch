+    /// Fork: after a handoff, re-detecting the same state keeps its original start.
+    #[test]
+    fn handoff_keeps_the_start_of_a_redetected_state() {
+        let mut app = app_with_workspaces(&["active"]);
+        let pane_id = app.workspaces[0].tabs[0].root_pane;
+        let terminal_id = app.workspaces[0].panes[&pane_id]
+            .attached_terminal_id
+            .clone();
+        app.terminals
+            .get_mut(&terminal_id)
+            .expect("terminal")
+            .restore_handoff_state_since(Some((AgentState::Working, 42)));
+        let change = |app: &mut AppState, state| {
+            app.handle_app_event(AppEvent::StateChanged {
+                pane_id,
+                agent: Some(Agent::Pi),
+                state,
+                visible_blocker: false,
+                visible_working: state == AgentState::Working,
+                process_exited: false,
+                observed_at: Instant::now(),
+            });
+        };
+        change(&mut app, AgentState::Working);
+        assert_eq!(
+            app.terminals[&terminal_id].agent_state_since_unix_ms,
+            Some(42)
+        );
+        change(&mut app, AgentState::Idle);
+        assert!(app.terminals[&terminal_id]
+            .agent_state_since_unix_ms
+            .is_some_and(|since| since > 42));
+
+        // A different state after the handoff starts fresh.
+        let terminal = app.terminals.get_mut(&terminal_id).expect("terminal");
+        terminal.restore_handoff_state_since(Some((AgentState::Blocked, 7)));
+        change(&mut app, AgentState::Working);
+        assert!(app.terminals[&terminal_id]
+            .agent_state_since_unix_ms
+            .is_some_and(|since| since > 42));
+    }
+
+    /// Fork: agents carry when their current state began, for the sidebar's ages.
+    #[test]
+    fn state_changes_record_when_the_state_began() {
+        let mut app = app_with_workspaces(&["active"]);
+        let pane_id = app.workspaces[0].tabs[0].root_pane;
+        let terminal_id = app.workspaces[0].panes[&pane_id]
+            .attached_terminal_id
+            .clone();
+        let before = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map(|elapsed| elapsed.as_millis() as u64)
+            .unwrap_or_default();
+        let change = |app: &mut AppState, state| {
+            app.handle_app_event(AppEvent::StateChanged {
+                pane_id,
+                agent: Some(Agent::Pi),
+                state,
+                visible_blocker: false,
+                visible_working: state == AgentState::Working,
+                process_exited: false,
+                observed_at: Instant::now(),
+            });
+        };
+        change(&mut app, AgentState::Working);
+        let since = app.terminals[&terminal_id].agent_state_since_unix_ms;
+        assert!(since.is_some_and(|since| since >= before));
+        // Repeating the same state keeps the original start.
+        app.terminals
+            .get_mut(&terminal_id)
+            .expect("terminal")
+            .agent_state_since_unix_ms = Some(1);
+        change(&mut app, AgentState::Working);
+        assert_eq!(
+            app.terminals[&terminal_id].agent_state_since_unix_ms,
+            Some(1)
+        );
+        change(&mut app, AgentState::Idle);
+        assert!(app.terminals[&terminal_id]
+            .agent_state_since_unix_ms
+            .is_some_and(|since| since >= before));
+    }
+
