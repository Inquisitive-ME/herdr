+    /// Fork: keep the pre-handoff start time when the state is already known, or
+    /// remember it until detection re-finds the same state after the handoff.
+    pub(crate) fn restore_handoff_state_since(&mut self, carried: Option<(AgentState, u64)>) {
+        let Some((state, since)) = carried else {
+            return;
+        };
+        if self.state == state {
+            self.agent_state_since_unix_ms = Some(since);
+        } else {
+            self.handoff_state_since = Some((state, since));
+        }
+    }
+
+    /// Fork: when a new state began; the carried handoff time if detection just
+    /// re-found the state the agent had before the handoff.
+    pub(crate) fn begin_agent_state(&mut self, state: AgentState, now_unix_ms: Option<u64>) {
+        self.agent_state_since_unix_ms = match self.handoff_state_since.take() {
+            Some((carried, since)) if carried == state => Some(since),
+            _ => now_unix_ms,
+        };
+    }
+
     pub(crate) fn finish_agent_process_acquisition(&mut self) -> bool {
         let reached_idle = self.agent_process_acquisition_pending && self.state == AgentState::Idle;
         let suppress_completion = reached_idle && self.recent_agent_process_exit.is_none();
